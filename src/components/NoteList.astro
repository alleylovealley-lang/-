---
import type { CollectionEntry } from 'astro:content';
import { url, isoDate, noteDate, STAGES } from '../lib/utils';
const { notes } = Astro.props as { notes: CollectionEntry<'notes'>[] };
---
<ul class="list">
  {notes.map((n) => (
    <li>
      <a href={url(`/garden/${n.id}`)}><span title={STAGES[n.data.stage].label}>{STAGES[n.data.stage].icon}</span> {n.data.title}</a>
      <time datetime={isoDate(noteDate(n))}>{isoDate(noteDate(n))}</time>
    </li>
  ))}
</ul>
