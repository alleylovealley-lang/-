---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/utils';
const { projects } = Astro.props as { projects: CollectionEntry<'projects'>[] };
---
<div class="cards">
  {projects.map((p) => (
    <a class="card" href={url(`/portfolio/${p.id}`)}>
      <span class="title">{p.data.title}</span>
      <span class="summary">{p.data.summary}</span>
      <span class="year">{p.data.date.getFullYear()}{p.data.role && ` · ${p.data.role}`}</span>
    </a>
  ))}
</div>
<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); gap: 0.85rem; }
  .card { display: flex; flex-direction: column; gap: 0.3rem; padding: 1.1rem 1.2rem; border: 1px solid var(--line); border-radius: 10px; text-decoration: none; transition: border-color 0.15s, transform 0.15s; }
  .card:hover { border-color: var(--pink-deep); color: inherit; transform: translateY(-2px); }
  .title { font-weight: 600; }
  .summary { color: var(--muted); font-size: 0.92rem; line-height: 1.6; flex: 1; }
  .year { color: var(--muted); font-size: 0.8rem; margin-top: 0.4rem; }
</style>
