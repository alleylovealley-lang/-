---
// 달력: 오늘(검정), 일기 쓴 날(핑크), 일정 있는 날(점)을 표시. big이면 칸에 일정 제목까지 표시.
import { getDiary, isoDate, scheduleJson } from '../lib/utils';
interface Props { big?: boolean }
const { big = false } = Astro.props;
const diary = [...new Set((await getDiary()).map((p) => isoDate(p.data.date)))];
const events = (await scheduleJson()).map((e) => ({ date: e.date, title: e.title, type: e.type, done: e.done }));
---
<div class:list={['calendar', { big }]} data-diary={JSON.stringify(diary)} data-events={JSON.stringify(events)}>
  <div class="cal-head"><button type="button" data-step="-1" aria-label="이전 달">‹</button><span class="cal-title"></span><button type="button" data-step="1" aria-label="다음 달">›</button></div>
  <div class="cal-grid"></div>
</div>
<script>
  type Ev = { date: string; title: string; type: string; done: boolean };
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  for (const el of document.querySelectorAll<HTMLElement>('.calendar')) {
    const diary = new Set<string>(JSON.parse(el.dataset.diary || '[]'));
    const events: Ev[] = JSON.parse(el.dataset.events || '[]');
    const big = el.classList.contains('big');
    const today = new Date();
    let y = today.getFullYear(), m = today.getMonth();
    const pad = (n: number) => String(n).padStart(2, '0');
    const draw = () => {
      el.querySelector('.cal-title')!.textContent = `${y}. ${pad(m + 1)}`;
      const first = new Date(y, m, 1).getDay(), days = new Date(y, m + 1, 0).getDate();
      let html = ['일', '월', '화', '수', '목', '금', '토'].map((d) => `<span class="w">${d}</span>`).join('');
      html += '<span class="e"></span>'.repeat(first);
      for (let d = 1; d <= days; d++) {
        const key = `${y}-${pad(m + 1)}-${pad(d)}`;
        const evs = events.filter((e) => e.date === key);
        const isToday = y === today.getFullYear() && m === today.getMonth() && d === today.getDate();
        const cls = [diary.has(key) && 'mk', evs.length && 'ev', isToday && 't'].filter(Boolean).join(' ');
        const list = big ? evs.map((e) => `<i class="${e.type}${e.done ? ' done' : ''}">${esc(e.title)}</i>`).join('') : '';
        html += `<span class="${cls}" title="${esc(evs.map((e) => e.title).join(', '))}"><b>${d}</b>${list}</span>`;
      }
      el.querySelector('.cal-grid')!.innerHTML = html;
    };
    el.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => {
      m += Number(b.dataset.step); if (m < 0) { m = 11; y--; } if (m > 11) { m = 0; y++; } draw();
    }));
    draw();
  }
</script>
