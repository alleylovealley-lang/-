---
// 본문 안의 작은 소제목 박스
interface Props { title: string; sub?: string; id?: string }
const { title, sub, id } = Astro.props;
---
<section class="box" id={id}>
  <h2><span>{title}</span>{sub && <small>{sub}</small>}</h2>
  <slot />
</section>
<style>
  .box { margin: 0 0 26px; scroll-margin-top: 20px; }
  h2 { display: flex; align-items: baseline; gap: 8px; margin: 0 0 10px; font: 400 14px var(--pixel); color: var(--pink-deep); border-bottom: 2px solid var(--pink-soft); padding-bottom: 4px; }
  h2::before { content: '♥'; font-size: 10px; color: var(--pink); }
  small { color: var(--mute); font: 12px var(--font); }
</style>
