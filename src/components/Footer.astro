---
import { SITE } from '../site.config';
import { url } from '../lib/utils';
const year = new Date().getFullYear();
const years = SITE.startYear < year ? `${SITE.startYear}–${year}` : `${year}`;
---
<footer class="container">
  <span>© {years} {SITE.name}</span>
  <span class="links">
    {SITE.links.map((l) => <a href={l.href} rel="me noopener">{l.label}</a>)}
    <a href={url('/tags')}>태그</a>
    <a href={url('/rss.xml')}>RSS</a>
  </span>
</footer>
<style>
  footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem 1rem; padding-top: 2rem; padding-bottom: 3rem; border-top: 1px solid var(--border); color: var(--muted); font-size: 0.85rem; }
  .links { display: flex; flex-wrap: wrap; gap: 1rem; }
  a { text-decoration: none; }
</style>
