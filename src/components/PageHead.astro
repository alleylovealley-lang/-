---
// 페이지 제목: 대주제 경로 + 큰 영어 + 작은 한글 + 설명 + 같은 대주제의 다른 메뉴 탭 + (선택) 페이지 안 바로가기
import { url } from '../lib/utils';
import { currentPath, findNav } from '../lib/nav';
interface Props { en: string; ko: string; desc?: string; tabs?: { label: string; href: string }[] }
const { en, ko, desc, tabs = [] } = Astro.props;
const path = currentPath(Astro.url.pathname);
const { group, item } = findNav(path);
---
<header class="phead">
  {group && <span class="crumb">{group.label} · {group.ko} ›</span>}
  <h1><span class="en">{en}</span> <span class="ko">· {ko}</span></h1>
  {desc && <p class="desc">{desc}</p>}
  {group && group.children.length > 1 && (
    <nav class="tabs" aria-label={`${group.ko} 메뉴`}>
      {group.children.map((c) => <a href={url(c.href)} aria-current={item?.href === c.href ? 'page' : undefined}>{c.label} · {c.ko}</a>)}
    </nav>
  )}
  {tabs.length > 0 && (
    <nav class="tabs jump" aria-label="바로가기">
      {tabs.map((t) => <a href={t.href.startsWith('#') ? t.href : url(t.href)}>{t.label}</a>)}
    </nav>
  )}
</header>
<style>
  .phead { border-bottom: 2px dashed var(--pink); padding-bottom: 12px; margin-bottom: 18px; }
  .crumb { font: 11px var(--pixel); color: var(--mute); text-decoration: none; }
  h1 { margin: 0; font: 400 26px/1.3 var(--pixel); color: var(--ink); }
  .ko { font: 400 20px var(--hand); color: var(--pink-deep); }
  .desc { margin: 4px 0 0; color: var(--mute); font-size: 13px; }
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .tabs a { font: 11px var(--pixel); padding: 2px 10px; border: 1.5px solid var(--line); border-radius: 10px; text-decoration: none; background: #fff; }
  .tabs a:hover, .tabs a[aria-current='page'] { border-color: var(--pink); background: var(--pink-soft); color: var(--pink-deep); }
  .tabs.jump { margin-top: 6px; }
  .tabs.jump a { border-style: dashed; font-size: 10.5px; }
  .tabs.jump a::before { content: '↓ '; color: var(--pink); }
</style>
