---
// 페이지 제목: 큰 영어 + 작은 한글 + 설명 + 하위 메뉴 탭
import { url } from '../lib/utils';
interface Props { en: string; ko: string; desc?: string; tabs?: { label: string; href: string }[]; current?: string }
const { en, ko, desc, tabs = [], current } = Astro.props;
---
<header class="phead">
  <h1><span class="en">{en}</span> <span class="ko">· {ko}</span></h1>
  {desc && <p class="desc">{desc}</p>}
  {tabs.length > 0 && (
    <nav class="tabs" aria-label={`${ko} 하위 메뉴`}>
      {tabs.map((t) => <a href={t.href.startsWith('#') ? t.href : url(t.href)} aria-current={current === t.href ? 'page' : undefined}>{t.label}</a>)}
    </nav>
  )}
</header>
<style>
  .phead { border-bottom: 2px dashed var(--pink); padding-bottom: 12px; margin-bottom: 18px; }
  h1 { margin: 0; font: 400 26px/1.3 var(--pixel); color: var(--ink); }
  .ko { font: 700 20px var(--hand); color: var(--pink-deep); }
  .desc { margin: 4px 0 0; color: var(--mute); font-size: 13px; }
  .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .tabs a { font: 11px var(--pixel); padding: 2px 10px; border: 1.5px solid var(--line); border-radius: 10px; text-decoration: none; background: #fff; }
  .tabs a:hover, .tabs a[aria-current='page'] { border-color: var(--pink); background: var(--pink-soft); color: var(--pink-deep); }
</style>
