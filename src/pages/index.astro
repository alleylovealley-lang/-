---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCards from '../components/ProjectCards.astro';
import NoteList from '../components/NoteList.astro';
import { SITE } from '../site.config';
import { url, getPosts, getProjects, getNotes } from '../lib/utils';

const posts = (await getPosts()).slice(0, 5);
const projects = (await getProjects()).slice(0, 4);
const notes = (await getNotes()).slice(0, 5);
---
<Base>
  <section class="hero">
    <h1>{SITE.name}</h1>
    <p class="lead">{SITE.intro}</p>
    <p class="muted">{SITE.description} <a href={url('/about')}>더 알아보기 →</a></p>
  </section>

  {posts.length > 0 && <>
    <h2 class="section-title">최근 글 <a href={url('/blog')}>전체 보기</a></h2>
    <PostList posts={posts} />
  </>}

  {projects.length > 0 && <>
    <h2 class="section-title">작업 <a href={url('/projects')}>전체 보기</a></h2>
    <ProjectCards projects={projects} />
  </>}

  {notes.length > 0 && <>
    <h2 class="section-title">최근 가꾼 정원 <a href={url('/garden')}>전체 보기</a></h2>
    <NoteList notes={notes} />
  </>}
</Base>
<style>
  .hero { padding-top: 1rem; }
  .hero h1 { font-size: 2.2rem; }
</style>
