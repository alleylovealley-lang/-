---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Box from '../../components/Box.astro';
import { SITE } from '../../site.config';
import my from '../../data/site.json';
import { url } from '../../lib/utils';
const TILES = [
  { k: 'photo', name: '프로필 사진', hint: '좌측 위 · 정사각형 추천' },
  { k: 'banner', name: '헤더 배너', hint: '맨 위 · 가로로 긴 이미지 (1400×160 정도)' },
  { k: 'sideBanner', name: '세로 배너', hint: '우측바 · 세로로 긴 이미지 (210×560 정도)' },
  { k: 'navTitle', name: '메뉴 제목 이미지', hint: '좌측 메뉴 위 · 190×46 정도' },
];
---
<Base title="SETTINGS · 설정">
  <meta slot="head" name="robots" content="noindex" />
    <PageHead en="SETTINGS" ko="설정" desc="프로필과 꾸미기, 보이는 방식, 브라우저에 저장된 데이터를 관리해요." tabs={[{ label: '프로필·꾸미기', href: '#profile' }, { label: 'GitHub 연결', href: '#github' }, { label: '화면', href: '#display' }]} />

  <Box title="PROFILE" sub="프로필·꾸미기" id="profile">
    <div class="pf" data-pf={JSON.stringify(my)} data-pf-repo={JSON.stringify(SITE.repo)} data-pf-base={url('/')}>
      <p class="pf-note" data-pf-notoken hidden>🔑 저장하려면 아래 <a href="#github">GitHub 연결</a>이 먼저 필요해요.</p>
      <div class="pf-fields">
        <label>이름 <small>(좌측 위 프로필, 맨 아래)</small><input type="text" name="pf-name" maxlength="20" /></label>
        <label>상태 메시지 <small>(이름 아래 한 줄, 비워도 돼요)</small><input type="text" name="pf-status" maxlength="40" placeholder="예: ☁ 오늘도 기록 중" /></label>
        <label>사이트 이름 <small>(브라우저 탭 제목)</small><input type="text" name="pf-title" maxlength="30" /></label>
      </div>
      <div class="pf-items">
        <p class="pf-cap">내 정보 <small>(프로필의 ▸ 내 정보를 누르면 보여요)</small></p>
        <div data-pf-items></div>
        <button type="button" class="pbtn sm" data-pf-add>＋ 항목 추가</button>
      </div>
      <p class="pf-cap">이미지 <small>(gif 움짤도 OK · 큰 이미지는 알맞게 줄여서 저장해요)</small></p>
      <div class="pf-tiles">
        {TILES.map((t) => (
          <div class="tile" data-tile={t.k}>
            <div class:list={['prev', t.k]} data-prev={t.k}></div>
            <b>{t.name}</b><small>{t.hint}</small>
            <div class="tb">
              <button type="button" class="pbtn sm" data-pick={t.k}>🖼 고르기</button>
              <button type="button" class="pbtn sm" data-clear={t.k}>✕ 비우기</button>
            </div>
            <input type="file" accept="image/*" hidden data-file={t.k} />
          </div>
        ))}
      </div>
      <p class="pf-err" data-pf-err aria-live="polite"></p>
      <div class="pf-foot">
        <span class="changed" data-pf-changed hidden>✎ 바뀐 내용이 있어요</span>
        <button type="button" class="pbtn" data-pf-reset>되돌리기</button>
        <button type="button" class="pbtn pink" data-pf-save>💾 저장하기</button>
      </div>
    </div>
  </Box>

  <Box title="GITHUB" sub="사이트 안에서 기록 저장하기" id="github">
    <div class="gh-box" data-repo={JSON.stringify(SITE.repo)}>
      <p class="state" data-gh-state>확인 중…</p>
      <div class="gh-form">
        <input type="password" placeholder="github_pat_로 시작하는 열쇠 붙여넣기" aria-label="GitHub 열쇠" data-gh-token autocomplete="off" />
        <button type="button" class="pbtn pink" data-gh-save>🔑 연결하기</button>
        <button type="button" class="pbtn" data-gh-remove>연결 끊기</button>
      </div>
      <details class="guide">
        <summary>열쇠(토큰) 만드는 법</summary>
        <ol>
          <li>GitHub 로그인 → 오른쪽 위 프로필 → <b>Settings</b></li>
          <li>왼쪽 맨 아래 <b>Developer settings</b> → <b>Personal access tokens</b> → <b>Fine-grained tokens</b> → <b>Generate new token</b></li>
          <li>이름은 아무거나, 기간(Expiration)은 원하는 만큼 (최대 1년, 만료되면 새로 만들어 다시 연결)</li>
          <li><b>Repository access</b> → <b>Only select repositories</b> → <code>{SITE.repo.owner}/{SITE.repo.name}</code> 선택</li>
          <li><b>Permissions</b> → Repository permissions → <b>Contents: Read and write</b></li>
          <li>맨 아래 <b>Generate token</b> → 나온 열쇠를 복사해서 위 칸에 붙여넣기</li>
        </ol>
        <p class="muted small">⚠ 열쇠는 이 브라우저에만 저장돼요. 다른 사람과 같이 쓰는 컴퓨터에서는 연결하지 마세요.</p>
      </details>
    </div>
  </Box>

  <Box title="DISPLAY" sub="화면" id="display">
    <div class="row"><span>글자 크기</span>
      <div class="filter" role="group" aria-label="글자 크기" data-group="zoom">
        <button type="button" data-v="0.9">작게</button><button type="button" data-v="1">보통</button><button type="button" data-v="1.1">크게</button><button type="button" data-v="1.2">아주 크게</button>
      </div>
    </div>
    <div class="row"><span>맨 위 흐르는 문구</span>
      <div class="filter" role="group" aria-label="흐르는 문구" data-group="marquee">
        <button type="button" data-v="on">움직이기</button><button type="button" data-v="off">멈추기</button>
      </div>
    </div>
    <div class="row"><span>메뉴</span><button type="button" class="pbtn" data-unfold>▾ 접은 메뉴 모두 펼치기</button></div>
  </Box>

  <Box title="BROWSER DATA" sub="이 브라우저에 저장된 데이터">
    <p class="muted small">습관 체크, 무드보드, 게임(코인·펫·도감) 기록은 이 브라우저에만 저장돼요. 다른 기기로 옮기거나 지워지기 전에 백업해 두세요.</p>
    <table class="data" data-table></table>
    <div class="btns">
      <button type="button" class="pbtn" data-export>⬇ 백업 파일 내보내기</button>
      <label class="pbtn">⬆ 백업 파일 불러오기 <input type="file" accept="application/json,.json" data-import hidden /></label>
    </div>
    <p class="msg" data-msg aria-live="polite"></p>
  </Box>

  <Box title="RESET" sub="초기화">
    <p class="reset-note">여기서는 <b>이 브라우저에만 저장된 것</b>(게임, 습관 체크, 표시 설정 등)을 지워요. 일기·병원·구독처럼 <b>사이트에 저장한 기록</b>은 각 기록 카드의 <b>🗑 삭제</b> 버튼으로 지워 주세요.</p>
    <div class="btns">
      <button type="button" class="pbtn" data-reset="game">🎮 게임 데이터 초기화</button>
      <button type="button" class="pbtn" data-reset="habit">✔ 습관 기록 초기화</button>
      <button type="button" class="pbtn" data-reset="all">⚠ 모두 초기화</button>
    </div>
  </Box>

  <Box title="SITE" sub="사이트 정보 바꾸기">
    <p class="small">이름·사진·배너는 위 <a href="#profile">프로필·꾸미기</a>에서 바꿔요. 소개 문구와 메뉴는 <code>src/site.config.ts</code>에서, 색과 글꼴은 <code>src/styles/global.css</code>에서 바꿀 수 있어요.</p>
  </Box>
</Base>
<script>
  import { load, save } from '../../lib/client';
  import { getToken, setToken, checkConnection, tokenProblem } from '../../lib/github';
  const $ = (s: string) => document.querySelector<HTMLElement>(`[data-${s}]`)!;
  const say = (m: string) => ($('msg').textContent = m);
  const LABEL: Record<string, string> = {
    coins: '🪙 코인', bonus: '🎁 출석 보너스', pet: '🐣 다마고치', 'fish.bucket': '🪣 낚시 바구니', 'fish.bucket2': '🪣 낚시 바구니(크기)', 'fish.dex': '📖 낚시 도감', 'fish.best': '📏 낚시 최고 기록',
    'shop': '🍦 아이스크림 가게', 'br31.record': '🔢 (예전) 31 전적', 'br31.level': '🔢 (예전) 31 난이도', 'roulette.hist': '🎡 룰렛 기록', habit: '✔ 습관 체크',
    moodboard: '🎨 자유 무드보드', 'thought.outbox': '💭 아직 못 올린 생각', 'draft.thought': '💭 쓰던 생각', 'pending.site': '👤 반영 중인 프로필', 'gh.token': '🔑 GitHub 열쇠', 'nav-folded': '☰ 접은 메뉴', zoom: '🔠 글자 크기', marquee: '✧ 흐르는 문구',
  };
  const GAME = ['coins', 'bonus', 'pet', 'fish.bucket', 'fish.bucket2', 'fish.dex', 'fish.best', 'br31.record', 'br31.level', 'roulette.hist', 'shop'];
  const keys = () => { const out: string[] = []; try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i)!; if (k.startsWith('hong.')) out.push(k.slice(5)); } } catch {} return out.sort(); };
  const drawTable = () => {
    const ks = keys();
    $('table').innerHTML = ks.length ? '<tr><th>항목</th><th>크기</th></tr>' + ks.map((k) => `<tr><td>${LABEL[k] ?? k}</td><td>${(localStorage.getItem('hong.' + k) ?? '').length.toLocaleString()} 글자</td></tr>`).join('') : '<tr><td>저장된 데이터가 없어요</td></tr>';
  };
  // 화면 설정
  const groups: Record<string, string> = { zoom: load('zoom', '1'), marquee: load('marquee', 'on') };
  const applyDisplay = () => {
    document.documentElement.style.setProperty('zoom', groups.zoom);
    document.documentElement.classList.toggle('no-marquee', groups.marquee === 'off');
    document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => g.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === groups[g.dataset.group!]))));
  };
  document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => g.querySelectorAll<HTMLButtonElement>('button').forEach((b) => b.addEventListener('click', () => {
    groups[g.dataset.group!] = b.dataset.v!; save(g.dataset.group!, b.dataset.v); applyDisplay(); drawTable();
  })));
  $('unfold').addEventListener('click', () => {
    save('nav-folded', []); document.querySelectorAll('.grp.folded').forEach((g) => { g.classList.remove('folded'); g.querySelector('.gh')?.setAttribute('aria-expanded', 'true'); });
    say('메뉴를 모두 펼쳤어요'); drawTable();
  });
  // 내보내기 / 불러오기
  $('export').addEventListener('click', () => {
    const data: Record<string, unknown> = {};
    keys().filter((k) => k !== 'gh.token').forEach((k) => { try { data[k] = JSON.parse(localStorage.getItem('hong.' + k)!); } catch {} }); // 열쇠는 백업에 넣지 않아요
    const blob = new Blob([JSON.stringify({ site: 'hong-room', exported: new Date().toISOString(), data }, null, 2)], { type: 'application/json' });
    const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `room-backup-${new Date().toISOString().slice(0, 10)}.json`; a.click(); URL.revokeObjectURL(a.href);
    say('백업 파일을 내려받았어요 💾');
  });
  ($('import') as HTMLInputElement).addEventListener('change', async (e) => {
    const f = (e.target as HTMLInputElement).files?.[0]; if (!f) return;
    try {
      const j = JSON.parse(await f.text());
      if (!j || typeof j.data !== 'object') throw new Error('형식');
      Object.entries(j.data).filter(([k]) => k !== 'gh.token').forEach(([k, v]) => save(k, v));
      say(`불러오기 완료! (${Object.keys(j.data).length}개 항목)`); drawTable(); window.dispatchEvent(new Event('coins'));
    } catch { say('이 파일은 불러올 수 없어요. 내보내기로 만든 백업 파일인지 확인해 주세요.'); }
    (e.target as HTMLInputElement).value = '';
  });
  // 초기화
  document.querySelectorAll<HTMLButtonElement>('[data-reset]').forEach((b) => b.addEventListener('click', () => {
    const t = b.dataset.reset!;
    const target = t === 'game' ? GAME : t === 'habit' ? ['habit'] : keys();
    const unsent = t === 'all' ? load<unknown[]>('thought.outbox', []).length : 0;
    if (!confirm((t === 'all' ? '이 브라우저에 저장된 모든 데이터를 지울까요? 되돌릴 수 없어요.' : '정말 초기화할까요? 되돌릴 수 없어요.') + (unsent ? `\n\n⚠ 아직 사이트에 못 올린 생각 ${unsent}개도 함께 지워져요.` : ''))) return;
    target.forEach((k) => { try { localStorage.removeItem('hong.' + k); } catch {} });
    say('초기화했어요'); drawTable(); window.dispatchEvent(new Event('coins'));
    if (t === 'all') { groups.zoom = '1'; groups.marquee = 'on'; applyDisplay(); }
  }));
  applyDisplay(); drawTable();

  // GitHub 연결
  const ghBox = document.querySelector<HTMLElement>('.gh-box')!;
  const repo = JSON.parse(ghBox.dataset.repo!);
  const state = $('gh-state');
  const showState = async () => {
    if (!getToken()) { state.textContent = '⚪ 아직 연결 안 됨 — 연결하면 홈에서 일기·수입/지출을 바로 쓸 수 있어요'; state.className = 'state'; return; }
    state.textContent = '확인 중…';
    const r = await checkConnection(repo);
    state.textContent = (r.ok ? '🟢 ' : '🔴 ') + r.message; state.className = 'state ' + (r.ok ? 'on' : 'off');
  };
  $('gh-save').addEventListener('click', async () => {
    const input = $('gh-token') as HTMLInputElement;
    const problem = tokenProblem(input.value);
    if (problem) { state.textContent = '🔴 ' + problem; state.className = 'state off'; return input.focus(); }
    setToken(input.value); input.value = ''; await showState(); drawTable();
  });
  $('gh-remove').addEventListener('click', () => { setToken(''); try { localStorage.removeItem('hong.gh.token'); } catch {} showState(); drawTable(); });
  showState();
</script>
<script>
  import { load, save, esc } from '../../lib/client';
  import { getToken, commitFiles, blobToB64, type Repo, type Change } from '../../lib/github';

  type My = { name: string; title: string; status: string; items: { label: string; value: string }[]; photo: string; banner: string; sideBanner: string; navTitle: string };
  type ImgKey = 'photo' | 'banner' | 'sideBanner' | 'navTitle';
  const IMGS: ImgKey[] = ['photo', 'banner', 'sideBanner', 'navTitle'];
  const MAX: Record<ImgKey, number> = { photo: 480, banner: 2400, sideBanner: 900, navTitle: 800 };
  const box = document.querySelector<HTMLElement>('[data-pf]')!;
  const q = <E extends HTMLElement = HTMLElement>(s: string) => box.querySelector<E>(s)!;
  const built: My = JSON.parse(box.dataset.pf!);
  const repo: Repo = JSON.parse(box.dataset.pfRepo!);
  const BASE = box.dataset.pfBase!;
  const RAW = `https://raw.githubusercontent.com/${repo.owner}/${repo.name}/${repo.branch}/public/`;
  /** 저장소에 지금 있는 값 (방금 저장해서 반영 중이면 그 값) */
  const current = (): My => { const p = load<{ data: My; ts: number } | null>('pending.site', null); return p && Date.now() - p.ts < 30 * 60_000 ? p.data : built; };
  let base = current();
  let draft: My = structuredClone(base);
  const staged = new Map<ImgKey, { blob: Blob; ext: string; url: string }>();
  const local: Partial<Record<ImgKey, string>> = {}; // 이 화면에서 올린 이미지 미리보기
  const shownUrl = (k: ImgKey) => {
    const st = staged.get(k); if (st) return st.url;
    const v = draft[k]; if (!v) return '';
    if (local[k] && v === base[k]) return local[k]!;
    return /^https?:/.test(v) ? v : (v === built[k] ? BASE : RAW) + v.replace(/^\//, '');
  };

  const field = (n: string) => q<HTMLInputElement>(`[name="pf-${n}"]`);
  const drawItems = () => {
    q('[data-pf-items]').innerHTML = draft.items.map((it, i) => `<div class="irow" data-i="${i}">
      <input type="text" data-k="label" value="${esc(it.label)}" placeholder="항목 (예: 생일)" maxlength="12" aria-label="항목 이름" />
      <input type="text" data-k="value" value="${esc(it.value)}" placeholder="내용 (예: 1월 1일)" maxlength="40" aria-label="항목 내용" />
      <button type="button" class="idel" data-idel="${i}" aria-label="이 항목 지우기">✕</button></div>`).join('') || '<p class="muted small">아직 항목이 없어요</p>';
  };
  const drawImgs = () => IMGS.forEach((k) => {
    const u = shownUrl(k), el = q(`[data-prev="${k}"]`);
    el.innerHTML = u ? `<img src="${esc(u)}" alt="" />` : '<span>비어 있음</span>';
    el.classList.toggle('empty', !u);
    q<HTMLButtonElement>(`[data-clear="${k}"]`).disabled = !u;
  });
  const dirty = () => staged.size > 0 || JSON.stringify(draft) !== JSON.stringify(base);
  const mark = () => { q('[data-pf-changed]').hidden = !dirty(); };
  const fill = () => {
    (['name', 'status', 'title'] as const).forEach((n) => (field(n).value = draft[n] ?? ''));
    drawItems(); drawImgs(); mark();
    q('[data-pf-notoken]').hidden = !!getToken();
  };
  (['name', 'status', 'title'] as const).forEach((n) => field(n).addEventListener('input', () => { draft[n] = field(n).value; mark(); }));
  q('[data-pf-items]').addEventListener('input', (e) => {
    const inp = e.target as HTMLInputElement, row = inp.closest<HTMLElement>('.irow'); if (!row) return;
    const it = draft.items[Number(row.dataset.i)]; if (inp.dataset.k === 'label') it.label = inp.value; else it.value = inp.value; mark();
  });
  q('[data-pf-items]').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-idel]'); if (!b) return;
    draft.items.splice(Number(b.dataset.idel), 1); drawItems(); mark();
  });
  q('[data-pf-add]').addEventListener('click', () => { draft.items.push({ label: '', value: '' }); drawItems(); mark(); q<HTMLInputElement>('[data-pf-items] .irow:last-child input').focus(); });

  /* ── 이미지 고르기 (큰 이미지는 줄이기, gif는 그대로, png는 투명 배경 유지) ── */
  const prep = async (file: File, k: ImgKey): Promise<{ blob: Blob; ext: string }> => {
    if (file.type === 'image/gif') { if (file.size > 6_000_000) throw new Error('gif가 너무 커요 (6MB까지)'); return { blob: file, ext: 'gif' }; }
    const u = URL.createObjectURL(file);
    try {
      const img = new Image(); img.src = u; await img.decode();
      const sc = Math.min(1, MAX[k] / Math.max(img.naturalWidth, img.naturalHeight));
      const c = document.createElement('canvas'); c.width = Math.round(img.naturalWidth * sc); c.height = Math.round(img.naturalHeight * sc);
      const keepAlpha = /png|webp/.test(file.type);
      const x = c.getContext('2d')!; if (!keepAlpha) { x.fillStyle = '#fff'; x.fillRect(0, 0, c.width, c.height); }
      x.drawImage(img, 0, 0, c.width, c.height);
      const blob = await new Promise<Blob | null>((r) => c.toBlob(r, keepAlpha ? 'image/png' : 'image/jpeg', 0.9));
      if (!blob) throw new Error();
      return { blob, ext: keepAlpha ? 'png' : 'jpg' };
    } catch { throw new Error(`'${file.name}'은(는) 열 수 없는 이미지 형식이에요`); }
    finally { URL.revokeObjectURL(u); }
  };
  IMGS.forEach((k) => {
    const inp = q<HTMLInputElement>(`[data-file="${k}"]`);
    q(`[data-pick="${k}"]`).addEventListener('click', () => inp.click());
    inp.addEventListener('change', async () => {
      const f = inp.files?.[0]; inp.value = ''; if (!f) return;
      if (!f.type.startsWith('image/')) { q('[data-pf-err]').textContent = '이미지 파일만 고를 수 있어요'; return; }
      try { const r = await prep(f, k); staged.set(k, { ...r, url: URL.createObjectURL(r.blob) }); q('[data-pf-err]').textContent = ''; drawImgs(); mark(); }
      catch (e) { q('[data-pf-err]').textContent = (e as Error).message; }
    });
    q(`[data-clear="${k}"]`).addEventListener('click', () => { staged.delete(k); draft[k] = ''; drawImgs(); mark(); });
  });
  q('[data-pf-reset]').addEventListener('click', () => { staged.clear(); draft = structuredClone(base); q('[data-pf-err]').textContent = ''; fill(); });

  /* ── 저장: 이미지 + site.json 을 커밋 하나로 ── */
  q('[data-pf-save]').addEventListener('click', async () => {
    const err = q('[data-pf-err]');
    const next: My = { ...draft, name: draft.name.trim(), title: draft.title.trim(), status: draft.status.trim(), items: draft.items.map((i) => ({ label: i.label.trim(), value: i.value.trim() })).filter((i) => i.label || i.value) };
    if (!next.name) { err.textContent = '이름을 적어 주세요'; field('name').focus(); return; }
    if (!next.title) next.title = `${next.name}의 작은 방`;
    if (!staged.size && JSON.stringify(next) === JSON.stringify(base)) { err.textContent = '바뀐 내용이 없어요'; return; }
    if (!getToken()) { err.textContent = '🔑 GitHub 연결이 필요해요'; q('[data-pf-notoken]').hidden = false; return; }
    const btn = q<HTMLButtonElement>('[data-pf-save]'); btn.disabled = true; btn.textContent = '저장 중…'; err.textContent = '';
    try {
      const stamp = Date.now().toString(36), changes: Change[] = [], fresh: Partial<Record<ImgKey, string>> = {};
      for (const [k, st] of staged) {
        const path = `/images/deco/${k}-${stamp}.${st.ext}`;
        changes.push({ path: `public${path}`, base64: await blobToB64(st.blob) });
        next[k] = path; fresh[k] = st.url;
      }
      // 예전에 사이트에서 올린 이미지가 바뀌거나 비워졌으면 그 파일은 지우기
      IMGS.forEach((k) => { const old = base[k]; if (old && old !== next[k] && old.startsWith(`/images/deco/${k}-`)) changes.push({ path: `public${old}`, remove: true }); });
      changes.push({ path: 'src/data/site.json', text: JSON.stringify(next, null, 2) + '\n' });
      await commitFiles(repo, changes, '설정: 프로필·꾸미기 바꾸기');
      save('pending.site', { data: next, ts: Date.now() });
      Object.assign(local, fresh);
      (window as unknown as { __applyMy?: (l: object) => void }).__applyMy?.(local);
      base = next; draft = structuredClone(next); staged.clear();
      fill();
      err.textContent = '💾 저장했어요! 이 브라우저에는 바로 보이고, 사이트 전체에는 1~2분 뒤 반영돼요';
    } catch (e) { err.textContent = (e as Error).message === 'NO_TOKEN' ? '🔑 GitHub 연결이 필요해요' : (e as Error).message; }
    finally { btn.disabled = false; btn.textContent = '💾 저장하기'; }
  });
  window.addEventListener('beforeunload', (e) => { if (dirty()) e.preventDefault(); });
  fill();
</script>
