---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Box from '../../components/Box.astro';
import QuestBar from '../../components/QuestBar.astro';
import { url, getTodos, md } from '../../lib/utils';
const todos = await getTodos();
const open = todos.filter((q) => !q.data.done);
const cleared = todos.filter((q) => q.data.done);
---
<Base title="QUEST · 퀘스트" description="할 일을 퀘스트로">
  <meta slot="head" name="robots" content="noindex" />
  <PageHead en="QUEST" ko="퀘스트" desc="할 일(TODO)을 완료하면 포인트가 쌓이고 레벨이 올라가요." />
  <Box title="MY LEVEL" sub="나의 레벨"><div class="lvbox"><QuestBar /></div></Box>
  <Box title="ACTIVE QUEST" sub="진행 중인 퀘스트">
    {open.length ? (
      <ul class="quests">{open.map((q) => <li class={q.data.priority}><span class="ico">⚔</span><span class="t">{q.data.title}{q.data.due && <small>{md(q.data.due)}까지</small>}</span><b>+{q.data.points}pt</b></li>)}</ul>
    ) : <p class="muted small">진행 중인 퀘스트가 없어요!</p>}
  </Box>
  <Box title="CLEARED" sub="완료한 퀘스트">
    <ul class="quests cleared">{cleared.map((q) => <li><span class="ico">★</span><span class="t">{q.data.title}{q.data.doneAt && <small>{md(q.data.doneAt)}</small>}</span><b>+{q.data.points}pt</b></li>)}</ul>
  </Box>
  <p class="muted small">✔ 퀘스트는 <a href={url('/todo')}>TODO</a> 목록에서 와요. 매일 습관 체크는 <a href={url('/habit')}>HABIT</a>에서, 미니게임 코인은 GAME에서 모을 수 있어요.</p>
</Base>
<style>
  .lvbox { border: 2px solid #555; border-radius: 8px; padding: 12px 14px; background: linear-gradient(#fff, #f6f6f6); box-shadow: 3px 3px 0 #bbb; max-width: 360px; }
  .quests { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .quests li { display: flex; align-items: center; gap: 10px; border: 1.5px solid var(--line); border-radius: 8px; padding: 6px 10px; background: #fff; }
  .quests li.high { border-color: var(--pink); }
  .quests .ico { font-size: 14px; color: var(--pink-deep); }
  .quests .t { flex: 1; }
  .quests small { margin-left: 8px; color: var(--mute); font: 11px var(--pixel); }
  .quests b { font: 400 12px var(--pixel); color: var(--pink-deep); }
  .cleared li { background: var(--pink-soft); border-color: var(--pink); }
</style>
