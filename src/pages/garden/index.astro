---
import Base from '../../layouts/Base.astro';
import NoteList from '../../components/NoteList.astro';
import { getNotes, STAGES } from '../../lib/utils';
const notes = await getNotes();
---
<Base title="정원" description="계속 자라는 메모들">
  <header class="page-header">
    <h1>디지털 정원</h1>
    <p class="muted">
      완성된 글이 아니라, 생각이 자라는 곳입니다. 메모는 시간이 지나며 다듬어집니다.
    </p>
    <p class="small muted">
      {Object.values(STAGES).map((s) => <span class="legend">{s.icon} {s.label}</span>)}
    </p>
  </header>
  <div style="margin-top: 2rem"><NoteList notes={notes} /></div>
</Base>
<style>.legend + .legend::before { content: ' · '; }</style>
