---
import Base from '../../layouts/Base.astro';
import GameShell from '../../components/GameShell.astro';
const SEG = [0, 2, 0.5, 1.5, 0, 3, 0, 1];
---
<Base title="ROULETTE · 베팅 룰렛">
  <GameShell en="ROULETTE" ko="베팅 룰렛" desc="코인을 걸고 룰렛을 돌려요. 멈춘 칸의 배수만큼 돌려받아요! (재미로만 ♡)">
    <div class="wrap">
      <div class="wheelbox">
        <span class="pointer" aria-hidden="true">▼</span>
        <div class="wheel" data-wheel data-seg={JSON.stringify(SEG)}>
          {SEG.map((m, i) => <span class="lbl" style={`--a:${i * 45 + 22.5}deg`}>{m === 0 ? '꽝' : `×${m}`}</span>)}
        </div>
        <span class="hub" aria-hidden="true">🎀</span>
      </div>
      <div class="ctrl">
        <label>걸 코인 <input type="number" min="1" step="1" value="10" data-bet /></label>
        <div class="quick">
          <button type="button" class="pbtn" data-q="10">10</button>
          <button type="button" class="pbtn" data-q="50">50</button>
          <button type="button" class="pbtn" data-q="half">절반</button>
          <button type="button" class="pbtn" data-q="all">올인</button>
        </div>
        <button type="button" class="pbtn pink spin" data-spin>🎡 돌리기!</button>
        <p class="msg" data-msg aria-live="polite">얼마를 걸어볼까요?</p>
        <p class="hist" data-hist></p>
      </div>
    </div>
  </GameShell>
</Base>
<script>
  import { getCoins, addCoins, load, save } from '../../lib/client';
  const $ = (s: string) => document.querySelector<HTMLElement>(`[data-${s}]`)!;
  const wheel = $('wheel'); const SEG: number[] = JSON.parse(wheel.dataset.seg!);
  const bet = $('bet') as HTMLInputElement; const spin = $('spin') as HTMLButtonElement;
  let rot = 0; let hist = load<number[]>('roulette.hist', []);
  const say = (m: string) => ($('msg').textContent = m);
  const drawHist = () => ($('hist').textContent = hist.length ? `최근 결과: ${hist.slice(-8).map((m) => (m ? `×${m}` : '꽝')).join(' · ')}` : '');
  document.querySelectorAll<HTMLButtonElement>('[data-q]').forEach((b) => b.addEventListener('click', () => {
    const c = getCoins(), q = b.dataset.q!;
    bet.value = String(Math.max(1, q === 'all' ? c : q === 'half' ? Math.floor(c / 2) : Math.min(c, Number(q))));
  }));
  spin.addEventListener('click', () => {
    const c = getCoins(), b = Math.floor(Number(bet.value));
    if (!b || b < 1) return say('1코인 이상 걸어주세요');
    if (b > c) return say(c ? `코인이 ${c}개뿐이에요 🥲` : '코인이 없어요! 낚시터나 31 게임으로 모아보세요 🎣');
    addCoins(-b); spin.disabled = true; say('두근두근… 🎡');
    const idx = Math.floor(Math.random() * SEG.length);
    // 포인터(위쪽)에 idx 칸 가운데가 오도록 회전
    const target = 360 - (idx * 45 + 22.5) + (Math.random() * 30 - 15);
    rot += 360 * 5 + ((target - (rot % 360)) + 360) % 360;
    wheel.style.transform = `rotate(${rot}deg)`;
    setTimeout(() => {
      const m = SEG[idx], win = Math.floor(b * m);
      if (win) addCoins(win);
      say(m === 0 ? `꽝! ${b}코인을 잃었어요 😭` : m < 1 ? `×${m}… ${win}코인만 돌아왔어요` : m === 1 ? `본전! ${win}코인 그대로 ✨` : `🎉 ×${m}! ${win}코인 획득 (+${win - b})`);
      hist.push(m); hist = hist.slice(-20); save('roulette.hist', hist); drawHist(); spin.disabled = false;
    }, 3200);
  });
  drawHist();
</script>
<style>
  .wrap { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: center; }
  .wheelbox { position: relative; width: 260px; height: 260px; }
  .wheel { position: absolute; inset: 0; border-radius: 50%; border: 4px solid #3a3a3a; transition: transform 3s cubic-bezier(0.15, 0.85, 0.2, 1);
    background: conic-gradient(#fff 0 45deg, #f3a5bf 45deg 90deg, #fff 90deg 135deg, #fdeef3 135deg 180deg, #fff 180deg 225deg, #e0709a 225deg 270deg, #fff 270deg 315deg, #ececec 315deg 360deg); }
  .lbl { position: absolute; left: 50%; top: 50%; font: 14px var(--pixel); transform: rotate(var(--a)) translateY(-96px) translateX(-50%); transform-origin: 0 0; color: #3a3a3a; }
  .pointer { position: absolute; top: -18px; left: 50%; transform: translateX(-50%); font-size: 24px; color: var(--pink-deep); z-index: 2; }
  .hub { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: 46px; height: 46px; border-radius: 50%; background: #fff; border: 3px solid #3a3a3a; display: grid; place-items: center; font-size: 20px; }
  .ctrl { display: flex; flex-direction: column; gap: 8px; min-width: 220px; }
  label { font: 12px var(--pixel); display: flex; align-items: center; gap: 8px; }
  input[type='number'] { width: 100px; border: 2px solid #555; border-radius: 4px; padding: 4px 6px; font: 14px var(--pixel); }
  .quick { display: flex; gap: 6px; flex-wrap: wrap; }
  .quick .pbtn { padding: 2px 10px; }
  .spin { font-size: 15px; padding: 8px; }
  .msg { font: 400 19px var(--hand); min-height: 1.5em; margin: 4px 0 0; }
  .hist { font: 11px var(--pixel); color: var(--mute); margin: 0; }
  @media (prefers-reduced-motion: reduce) { .wheel { transition-duration: 0.3s; } }
</style>
