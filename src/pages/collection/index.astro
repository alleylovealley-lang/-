---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Box from '../../components/Box.astro';
import { render } from 'astro:content';
import { url, getCollectionItems, getArchive, isoDate } from '../../lib/utils';
const items = await Promise.all((await getCollectionItems()).map(async (e) => ({ e, Content: (await render(e)).Content })));
const moments = items.filter(({ e }) => e.data.category === 'moment');
const mornings = items.filter(({ e }) => e.data.category === 'morning');
const quotes = await Promise.all((await getArchive()).filter((e) => e.data.kind === 'quote' && e.data.starred).map(async (e) => ({ e, Content: (await render(e)).Content })));
---
<Base title="COLLECTION · 컬렉션" description="특별히 좋아하거나 수집하는 것들">
  <PageHead en="COLLECTION" ko="컬렉션" desc="특별히 좋아하거나 수집하는 것들을 모아두는 공간."
    tabs={[{ label: '좋아하는 순간', href: '#moments' }, { label: '기억하고 싶은 문장', href: '#quotes' }, { label: '느린 아침의 기록', href: '#mornings' }]} />

  <Box title="좋아하는 순간" sub="FAVORITE MOMENTS" id="moments">
    <div class="cards">{moments.map(({ e, Content }) => (
      <div class="card">{e.data.image && <img src={url(e.data.image)} alt="" loading="lazy" />}<b>{e.data.title}</b><small>{isoDate(e.data.date)}</small><div class="tx"><Content /></div></div>
    ))}</div>
  </Box>

  <Box title="오래 기억하고 싶은 문장" sub="★ ARCHIVE에서 모아옴" id="quotes">
    <div class="qcards">{quotes.map(({ e, Content }) => e.data.kind === 'quote' && (
      <figure><Content /><figcaption>— {e.data.source}</figcaption></figure>
    ))}</div>
  </Box>

  <Box title="느린 아침의 기록" sub="SLOW MORNING" id="mornings">
    <div class="cards">{mornings.map(({ e, Content }) => (
      <div class="card morning">{e.data.image && <img src={url(e.data.image)} alt="" loading="lazy" />}<b>☕ {e.data.title}</b><small>{isoDate(e.data.date)}</small><div class="tx"><Content /></div></div>
    ))}</div>
  </Box>
</Base>
<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 10px; }
  .card { border: 2px solid var(--line); border-radius: 10px; padding: 8px; background: #fff; box-shadow: 3px 3px 0 #e6e6e6; }
  .card img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; display: block; margin-bottom: 6px; }
  .card b { font: 700 17px var(--hand); display: block; }
  .card small { color: var(--mute); font: 11px var(--pixel); }
  .tx { font-size: 12.5px; color: #666; }
  .tx :global(p) { margin: 4px 0 0; }
  .morning { background: #fbfaf7; }
  .qcards { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  figure { margin: 0; padding: 18px 16px; text-align: center; border: 2px dashed var(--pink); border-radius: 10px; background: var(--pink-soft); font: 700 18px/1.5 var(--hand); }
  figure :global(p) { margin: 0; }
  figcaption { font: 11px var(--pixel); color: var(--mute); margin-top: 6px; }
</style>
