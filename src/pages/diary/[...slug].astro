---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { url, getDiary, formatDate, isoDate } from '../../lib/utils';
import { findIdiom } from '../../lib/idioms';

export async function getStaticPaths() {
  const entries = await getDiary();
  return entries.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, newer: entries[i - 1], older: entries[i + 1] } }));
}
const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const { title, date, mood, weather, tags, line, done, idiom } = entry.data;
const idm = findIdiom(idiom);
---
<Base title={title} type="article">
  <article>
    <header class="page-header">
      <p class="small"><a href={url('/diary')}>← DIARY</a></p>
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        {weather && <span>{weather}</span>}
        {mood && <span>{mood}</span>}
      </div>
    </header>
    {idiom && <p class="idiom"><b>{idiom}</b>{idm && <span>{idm.h} · {idm.m}</span>}</p>}
    {line && <p class="line">“{line}”</p>}
    {done.length > 0 && <ul class="done">{done.map((d) => <li>{d}</li>)}</ul>}
    <div class="prose"><Content /></div>
    <Tags tags={tags} />
  </article>
  {(older || newer) && (
    <nav class="pager" aria-label="이전/다음 일기">
      {older ? <a href={url(`/diary/${older.id}`)}><span class="muted small">← 이전</span>{older.data.title}</a> : <span />}
      {newer ? <a class="next" href={url(`/diary/${newer.id}`)}><span class="muted small">다음 →</span>{newer.data.title}</a> : <span />}
    </nav>
  )}
</Base>

<style>
  .idiom { margin: 18px 0 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
  .idiom b { font: 400 18px var(--pixel); color: #fff; background: var(--pink-deep); border-radius: 6px; padding: 2px 12px; letter-spacing: 0.15em; }
  .idiom span { font-size: 13px; color: var(--mute); }
  .line { margin: 18px 0 8px; font: 400 24px/1.4 var(--hand); }
  .done { margin: 0; padding: 10px 14px; list-style: none; border: 2px dashed var(--pink); border-radius: 10px; background: var(--pink-soft); font-size: 14px; line-height: 1.9; }
  .done li::before { content: '✔ '; color: var(--pink-deep); }
</style>
