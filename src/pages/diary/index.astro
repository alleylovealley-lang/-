---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Box from '../../components/Box.astro';
import DiaryForm from '../../components/DiaryForm.astro';
import { url, getDiary, isoDate } from '../../lib/utils';
import { IDIOMS } from '../../lib/idioms';
import { SITE } from '../../site.config';

const entries = (await getDiary()).map((e) => ({
  date: isoDate(e.data.date), title: e.data.title, idiom: e.data.idiom, mood: e.data.mood, weather: e.data.weather, line: e.data.line,
  done: e.data.done, memo: (e.body ?? '').trim() || undefined, path: e.filePath, href: url(`/diary/${e.id}`),
}));
---
<Base title="DIARY · 일기" description="하루를 마무리하며 오늘 한 일을 간단히 정리해요">
  <PageHead en="DIARY" ko="일기" desc="하루를 마무리하며, 오늘 무얼 했는지 간단히 정리해요." />

  <div class="diary" data-entries={JSON.stringify(entries)} data-idioms={JSON.stringify(IDIOMS)} data-repo={JSON.stringify(SITE.repo)}>
    <Box title="오늘의 기록" sub="TODAY" id="write">
      <div class="today-done" data-today hidden></div>
      <div class="write-box" data-writebox><DiaryForm id="page" /></div>
    </Box>

    <Box title="모아보기" sub="COLLECTION" id="list">
      <div class="cal">
        <div class="cal-nav"><button type="button" data-m="-1" aria-label="이전 달">‹</button><b data-month></b><button type="button" data-m="1" aria-label="다음 달">›</button></div>
        <div class="cal-grid" data-cal></div>
        <p class="cal-sum" data-sum></p>
      </div>
      <div class="cards" data-cards></div>
    </Box>
  </div>
  <div class="toast" data-toast role="status" hidden></div>
</Base>

<script>
  import { todayKey, load, save, esc, pad, hiddenPaths, markDeleted } from '../../lib/client';
  import { getToken, deleteFile, type Repo } from '../../lib/github';
  type E = { date: string; title: string; idiom?: string; mood?: string; weather?: string; line?: string; done: string[]; memo?: string; path?: string; href?: string; pending?: boolean };
  const root = document.querySelector<HTMLElement>('.diary')!;
  const $ = (s: string) => root.querySelector<HTMLElement>(`[data-${s}]`)!;
  const built: E[] = JSON.parse(root.dataset.entries || '[]');
  const repo: Repo = JSON.parse(root.dataset.repo!);
  const idioms: { k: string; h: string; m: string }[] = JSON.parse(root.dataset.idioms || '[]');
  const meaning = (k?: string) => idioms.find((i) => i.k === k?.trim());
  const DAYS = '일월화수목금토';
  const now = new Date();
  let y = now.getFullYear(), m = now.getMonth();

  /** 사이트에 이미 반영된 기록 + 방금 저장해서 반영 중인 기록 */
  const all = (): E[] => {
    const pend = load<(E & { at: number })[]>('pending.diary', []).filter((p) => Date.now() - p.at < 20 * 60_000);
    const fresh = pend.filter((p) => { const b = built.find((x) => x.path === p.path); return !b || b.line !== p.line || b.done.join() !== p.done.join() || b.idiom !== p.idiom; });
    save('pending.diary', fresh);
    const gone = hiddenPaths('diary', built.map((b) => b.path));
    const merged = [...built.filter((b) => !gone.has(b.path!) && !fresh.some((p) => p.path === b.path)), ...fresh.map((p) => ({ ...p, pending: true }))];
    return merged.sort((a, b) => b.date.localeCompare(a.date));
  };
  const dayName = (d: string) => DAYS[new Date(d + 'T00:00').getDay()];
  const moodEmoji = (mood?: string) => (mood ? [...mood][0] : '');

  const card = (e: E, big = false) => `
    <article class="card${big ? ' big' : ''}${e.pending ? ' pending' : ''}" id="d-${e.date}">
      <header>
        <b>${Number(e.date.slice(5, 7))}.${Number(e.date.slice(8))} <small>(${dayName(e.date)})</small></b>
        ${e.weather || e.mood ? `<span class="wm">${e.weather ?? ''} ${esc(e.mood ?? '')}</span>` : ''}
        ${e.pending ? '<em>반영 중</em>' : ''}
      </header>
      ${e.idiom ? (() => { const i = meaning(e.idiom); return `<p class="idiom"><b>${esc(e.idiom!)}</b>${i ? ` <small>${i.h} · ${esc(i.m)}</small>` : ''}</p>`; })() : ''}
      ${e.line ? `<p class="line">“${esc(e.line)}”</p>` : ''}
      ${e.done.length ? `<ul class="done">${e.done.map((d) => `<li>${esc(d)}</li>`).join('')}</ul>` : ''}
      ${e.memo ? `<p class="memo">${esc(e.memo).replace(/\n/g, '<br>')}</p>` : ''}
      <footer>${e.path ? `<button type="button" class="pbtn sm" data-edit="${esc(e.path)}">✎ 고치기</button><button type="button" class="pbtn sm del" data-del="${esc(e.path)}">🗑 삭제</button>` : ''}${e.href && !e.pending ? `<a href="${e.href}">자세히 ›</a>` : ''}</footer>
    </article>`;

  const draw = () => {
    const list = all();
    // 오늘 기록이 있으면 위에 보여주기
    const today = list.find((e) => e.date === todayKey());
    $('today').hidden = !today;
    $('today').innerHTML = today ? `<p class="ok">✔ 오늘의 기록을 남겼어요</p>${card(today, true)}<p class="again">다른 날의 기록도 아래 양식으로 쓸 수 있어요.</p>` : '';
    // 달력
    $('month').textContent = `${y}. ${pad(m + 1)}`;
    const first = new Date(y, m, 1).getDay(), days = new Date(y, m + 1, 0).getDate();
    const byDate = new Map(list.map((e) => [e.date, e]));
    let h = [...DAYS].map((d) => `<span class="w">${d}</span>`).join('') + '<span class="e"></span>'.repeat(first);
    let cnt = 0;
    for (let d = 1; d <= days; d++) {
      const k = `${y}-${pad(m + 1)}-${pad(d)}`, e = byDate.get(k); if (e) cnt++;
      h += e ? `<a class="d has${k === todayKey() ? ' t' : ''}" href="#d-${k}" title="${esc([e.idiom, e.line].filter(Boolean).join(' · ') || e.title)}"><i>${d}</i>${e.idiom ? `<b class="id">${esc([...e.idiom].slice(0, 4).join(''))}</b>` : `<b>${moodEmoji(e.mood) || '✎'}</b>`}</a>` : `<span class="d${k === todayKey() ? ' t' : ''}"><i>${d}</i></span>`;
    }
    $('cal').innerHTML = h;
    $('sum').textContent = cnt ? `이번 달 ${cnt}일 기록했어요` : '이 달에는 아직 기록이 없어요';
    // 카드 (이 달)
    const month = list.filter((e) => e.date.startsWith(`${y}-${pad(m + 1)}`));
    $('cards').innerHTML = month.length ? month.map((e) => card(e)).join('') : list.length ? '' : '<p class="empty">아직 기록이 없어요. 위 양식으로 오늘을 정리해 보세요 ✏️</p>';
  };
  root.querySelectorAll<HTMLButtonElement>('[data-m]').forEach((b) => b.addEventListener('click', () => { m += Number(b.dataset.m); if (m < 0) { m = 11; y--; } if (m > 11) { m = 0; y++; } draw(); }));
  root.addEventListener('click', async (ev) => {
    const d = (ev.target as HTMLElement).closest<HTMLButtonElement>('[data-del]');
    if (d) {
      const e = all().find((x) => x.path === d.dataset.del); if (!e) return;
      if (!getToken()) { toast('🔑 먼저 설정 › GitHub 연결이 필요해요'); return; }
      if (!confirm(`${e.date} 기록을 완전히 지울까요? 되돌릴 수 없어요.`)) return;
      d.disabled = true; d.textContent = '지우는 중…';
      try {
        await deleteFile(repo, e.path!, `일기: ${e.date} 삭제`);
        markDeleted('diary', e.path!);
        draw(); toast('🗑 일기를 지웠어요');
      } catch (x2) { toast((x2 as Error).message); d.disabled = false; d.textContent = '🗑 삭제'; }
      return;
    }
    const b = (ev.target as HTMLElement).closest<HTMLElement>('[data-edit]'); if (!b) return;
    const e = all().find((x) => x.path === b.dataset.edit); if (!e) return;
    window.dispatchEvent(new CustomEvent('diary-edit', { detail: e }));
    document.getElementById('write')?.scrollIntoView({ behavior: 'smooth' });
  });
  const toast = (msg: string) => { const t = document.querySelector<HTMLElement>('[data-toast]')!; t.textContent = msg; t.hidden = false; setTimeout(() => (t.hidden = true), 4000); };
  window.addEventListener('diary-saved', (ev) => {
    const e = (ev as CustomEvent<E>).detail; [y, m] = [Number(e.date.slice(0, 4)), Number(e.date.slice(5, 7)) - 1];
    draw(); toast('💾 저장했어요! 1~2분 뒤 사이트에 완전히 반영돼요');
  });
  draw();
</script>

<style>
  .today-done .ok { margin: 0 0 8px; font: 12px var(--pixel); color: var(--pink-deep); }
  .today-done .again { margin: 10px 0 14px; font-size: 12px; color: var(--mute); }
  .write-box { border: 2px dashed var(--pink); border-radius: 10px; padding: 14px 16px; background: var(--pink-soft); }
  .cal { max-width: 460px; margin-bottom: 18px; }
  .cal-nav { display: flex; justify-content: space-between; align-items: center; font: 14px var(--pixel); margin-bottom: 6px; }
  .cal-nav button { border: none; background: none; cursor: pointer; font-size: 18px; color: var(--mute); padding: 0 10px; }
  .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 3px; }
  .cal-grid :global(.w) { text-align: center; font: 11px var(--pixel); color: var(--pink-deep); background: var(--pink-soft); border-radius: 3px; }
  .cal-grid :global(.d) { position: relative; aspect-ratio: 1; border: 1px solid #eee; border-radius: 6px; background: #fff; display: flex; align-items: center; justify-content: center; text-decoration: none; }
  .cal-grid :global(.d i) { position: absolute; top: 2px; left: 4px; font: normal 10px var(--pixel); color: var(--mute); }
  .cal-grid :global(.d b) { font-size: 18px; font-weight: 400; margin-top: 6px; }
  .cal-grid :global(.d b.id) { font: 400 13px/1.1 var(--hand); color: var(--pink-deep); text-align: center; word-break: break-all; padding: 0 2px; }
  .cal-grid :global(.d.has) { background: var(--pink-soft); border-color: var(--pink); }
  .cal-grid :global(.d.has:hover) { border-color: var(--pink-deep); }
  .cal-grid :global(.d.t) { outline: 2px solid #3a3a3a; }
  .cal-sum { font: 11px var(--pixel); color: var(--mute); margin: 6px 0 0; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
  :global(.diary .card) { border: 1.5px solid var(--line); border-radius: 10px; padding: 10px 14px; background: #fff; scroll-margin-top: 20px; display: flex; flex-direction: column; gap: 6px; }
  :global(.diary .card.big) { border: 2px solid var(--pink-deep); }
  :global(.diary .card.pending) { border-style: dashed; }
  :global(.diary .card header) { display: flex; align-items: baseline; gap: 8px; }
  :global(.diary .card header b) { font: 400 15px var(--pixel); }
  :global(.diary .card header small) { color: var(--mute); }
  :global(.diary .card .wm) { font-size: 13px; }
  :global(.diary .card em) { margin-left: auto; font: normal 10px var(--pixel); color: #fff; background: var(--pink); border-radius: 3px; padding: 0 5px; }
  :global(.diary .card .idiom) { margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; }
  :global(.diary .card .idiom b) { font: 400 13px var(--pixel); color: #fff; background: var(--pink-deep); border-radius: 4px; padding: 1px 8px; letter-spacing: 0.1em; }
  :global(.diary .card .idiom small) { font-size: 11.5px; color: var(--mute); }
  :global(.diary .card .line) { margin: 0; font: 400 18px/1.4 var(--hand); }
  :global(.diary .card .done) { margin: 0; padding: 0; list-style: none; font-size: 13px; }
  :global(.diary .card .done li::before) { content: '✔ '; color: var(--pink-deep); }
  :global(.diary .card .memo) { margin: 0; font-size: 12.5px; color: #777; }
  :global(.diary .card footer) { display: flex; justify-content: flex-end; align-items: center; gap: 10px; margin-top: auto; font-size: 11px; }
  :global(.diary .card footer a) { color: var(--mute); text-decoration: none; }
  :global(.diary .card .del) { color: var(--mute); }
  :global(.pbtn.sm) { font-size: 11px; padding: 1px 8px; box-shadow: 1px 1px 0 #bbb; border-width: 1.5px; }
  .toast { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 50; background: #3a3a3a; color: #fff; padding: 10px 18px; border-radius: 10px; font-size: 13px; box-shadow: 0 4px 14px #0003; }
</style>
