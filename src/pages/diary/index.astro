---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Box from '../../components/Box.astro';
import { url, getDiary, isoDate, md } from '../../lib/utils';

const entries = await getDiary();
const latest = entries[0];
---
<Base title="DIARY · 일기" description="일상과 생각, 감정을 기록하는 공간">
  <PageHead en="DIARY" ko="일기" desc="날짜별로 일상과 생각, 감정을 기록하는 공간." />

  {latest && (
    <Box title="오늘의 기록" sub="TODAY">
      <a class="today" href={url(`/diary/${latest.id}`)} data-date={isoDate(latest.data.date)}>
        <b>{latest.data.title}</b>
        <span class="meta">{isoDate(latest.data.date)} {latest.data.weather} {latest.data.mood}</span>
        <span class="excerpt">{(latest.body ?? '').replace(/[#>*`\-\[\]()!]/g, '').slice(0, 90)}…</span>
        <span class="not-today">아직 오늘의 기록이 없어요. 가장 최근 기록이에요 ✎</span>
      </a>
    </Box>
  )}

  <Box title="날짜별 일기" sub="BY DATE">
    {entries.length === 0 && <p class="empty">아직 일기가 없어요. 홈의 ✏️ 오늘 일기 쓰기로 첫 일기를 써 보세요</p>}
    <ul class="list diary-list">
      {entries.map((e) => (
        <li>
          <a href={url(`/diary/${e.id}`)}> {e.data.title}{e.data.draft && <span class="muted small"> (초안)</span>}</a>
          <time datetime={isoDate(e.data.date)}>{isoDate(e.data.date).replaceAll('-', '.')}</time>
        </li>
      ))}
    </ul>
  </Box>
</Base>

<script>
  const pad = (n: number) => String(n).padStart(2, '0');
  const d = new Date(), key = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
  document.querySelectorAll<HTMLElement>('.today').forEach((el) => el.classList.toggle('is-today', el.dataset.date === key));
</script>

<style>
  .today { display: flex; flex-direction: column; gap: 3px; padding: 14px 16px; border: 2px dashed var(--pink); border-radius: 10px; background: var(--pink-soft); text-decoration: none; }
  .today b { font: 400 20px var(--hand); }
  .meta { color: var(--mute); font: 11px var(--pixel); }
  .excerpt { color: #777; font-size: 13px; }
  .not-today { font-size: 11px; color: var(--pink-deep); }
  .today.is-today .not-today { display: none; }
</style>
