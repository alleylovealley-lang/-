---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Tags from '../../components/Tags.astro';
import { url, getProjects } from '../../lib/utils';

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, date, role, link, repo, tags } = project.data;
---
<Base title={title} description={summary} type="article">
  <article>
    <header class="page-header">
      <p class="small"><a href={url('/portfolio')}>← PORTFOLIO</a></p>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
      <div class="meta">
        <span>{date.getFullYear()}</span>
        {role && <span>{role}</span>}
        {link && <a href={link} rel="noopener">사이트 ↗</a>}
        {repo && <a href={repo} rel="noopener">소스 코드 ↗</a>}
      </div>
    </header>
    <div class="prose"><Content /></div>
    <Tags tags={tags} />
  </article>
</Base>
