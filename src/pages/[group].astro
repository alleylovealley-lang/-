---
// 대주제 페이지: 하위 메뉴를 카드로 모아 보여줘요 (/record, /life, ...)
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';
import { url } from '../lib/utils';

export function getStaticPaths() {
  return SITE.nav.map((g) => ({ params: { group: g.key }, props: { g } }));
}
const { g } = Astro.props;
---
<Base title={`${g.label} · ${g.ko}`} description={g.desc}>
  <header class="phead">
    <h1><span class="en">{g.label}</span> <span class="ko">· {g.ko}</span></h1>
    {g.desc && <p class="desc">{g.desc}</p>}
  </header>
  <div class="cards">
    {g.children.map((c) => (
      <a class="card" href={url(c.href)}>
        <span class="en">{c.label}</span>
        <span class="ko">{c.ko}</span>
        {c.desc && <span class="d">{c.desc}</span>}
        <span class="go" aria-hidden="true">🎀 ›</span>
      </a>
    ))}
  </div>
</Base>
<style>
  .phead { border-bottom: 2px dashed var(--pink); padding-bottom: 12px; margin-bottom: 18px; }
  h1 { margin: 0; font: 400 26px/1.3 var(--pixel); }
  h1 .ko { font: 400 20px var(--hand); color: var(--pink-deep); }
  .desc { margin: 4px 0 0; color: var(--mute); font-size: 13px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
  .card { position: relative; display: flex; flex-direction: column; gap: 2px; padding: 14px 16px; border: 2px solid #555; border-radius: 8px; background: linear-gradient(#fff, #f1f1f1); box-shadow: 3px 3px 0 #bbb; text-decoration: none; color: var(--ink); }
  .card:hover { border-color: var(--pink-deep); background: linear-gradient(#fff, var(--pink-soft)); color: var(--ink); }
  .card:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #bbb; }
  .card .en { font: 18px var(--pixel); }
  .card .ko { font: 400 17px var(--hand); color: var(--pink-deep); }
  .card .d { font-size: 12px; color: var(--mute); margin-top: 4px; }
  .card .go { position: absolute; top: 12px; right: 12px; font-size: 13px; }
</style>
