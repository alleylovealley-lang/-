---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { render } from 'astro:content';
import { url, getScrapbook, isoDate } from '../../lib/utils';
const items = await Promise.all((await getScrapbook()).map(async (e) => ({ e, Content: (await render(e)).Content })));
const KIND = { image: '🖼 IMAGE', link: '🔗 LINK', quote: '❝ QUOTE' } as const;
---
<Base title="SCRAPBOOK · 스크랩북" description="이미지, 링크, 문장 스크랩">
  <PageHead en="SCRAPBOOK" ko="스크랩북" desc="마음에 드는 이미지, 링크, 문장을 오려 붙이는 곳." />
  <div class="filter" role="group" aria-label="종류">
    <button type="button" data-k="all" aria-pressed="true">ALL</button>
    {Object.entries(KIND).map(([k, v]) => <button type="button" data-k={k} aria-pressed="false">{v}</button>)}
  </div>
  {items.length === 0 && <p class="empty">아직 스크랩이 없어요</p>}
  <div class="board">
    {items.map(({ e, Content }, i) => (
      <article class:list={['scrap', e.data.kind]} data-k={e.data.kind} style={`--r:${[-1.5, 1, -0.5, 1.5, 0][i % 5]}deg`}>
        <span class="tape" aria-hidden="true"></span>
        {e.data.kind === 'image' && e.data.image && <img src={url(e.data.image)} alt={e.data.title ?? ''} loading="lazy" />}
        {e.data.kind === 'quote' ? (
          <blockquote><Content />{e.data.source && <cite>— {e.data.source}</cite>}</blockquote>
        ) : (
          <>
            {e.data.title && (e.data.kind === 'link' && e.data.url ? <a class="t" href={e.data.url} rel="noopener" target="_blank">🔗 {e.data.title} ↗</a> : <b class="t">{e.data.title}</b>)}
            <div class="tx"><Content /></div>
          </>
        )}
        <small>{KIND[e.data.kind]} · {isoDate(e.data.date)}</small>
      </article>
    ))}
  </div>
</Base>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter button');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.scrap').forEach((el) => (el.hidden = b.dataset.k !== 'all' && el.dataset.k !== b.dataset.k));
  }));
</script>
<style>
  .board { columns: 3 210px; column-gap: 14px; margin-top: 14px; }
  .scrap { break-inside: avoid; position: relative; margin: 0 0 16px; padding: 14px 12px 10px; background: #fff; border: 1.5px solid var(--line); border-radius: 6px; box-shadow: 2px 3px 0 #e6e6e6; transform: rotate(var(--r)); }
  .scrap[hidden] { display: none; }
  .tape { position: absolute; top: -8px; left: 50%; width: 64px; height: 16px; margin-left: -32px; background: repeating-linear-gradient(45deg, rgba(243,165,191,.7) 0 5px, rgba(253,238,243,.8) 5px 10px); }
  .scrap img { width: 100%; border-radius: 4px; display: block; margin-bottom: 6px; }
  .t { display: block; font: 400 18px var(--hand); text-decoration: none; }
  .tx { font-size: 12.5px; color: #666; }
  .tx :global(p) { margin: 4px 0; }
  .quote { background: var(--pink-soft); border-color: var(--pink); }
  blockquote { margin: 0; font: 400 19px/1.5 var(--hand); text-align: center; }
  blockquote :global(p) { margin: 0; }
  cite { display: block; font: normal 11px var(--pixel); color: var(--mute); margin-top: 6px; }
  small { display: block; margin-top: 6px; font: 10px var(--pixel); color: #b0b0b0; }
</style>
