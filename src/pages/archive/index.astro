---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Box from '../../components/Box.astro';
import { render } from 'astro:content';
import { url, getArchive, isoDate } from '../../lib/utils';

const all = await getArchive();
const withHtml = await Promise.all(all.map(async (e) => ({ e, Content: (await render(e)).Content })));
const pick = (k: string) => withHtml.filter(({ e }) => e.data.kind === k);
const books = pick('book');
const reading = books.filter(({ e }) => e.data.kind === 'book' && e.data.status === 'reading');
const done = books.filter(({ e }) => e.data.kind === 'book' && e.data.status === 'done');
const want = books.filter(({ e }) => e.data.kind === 'book' && e.data.status === 'want');
const places = pick('place');
const quotes = pick('quote').sort((a, b) => +(('date' in b.e.data && b.e.data.date) || 0) - +(('date' in a.e.data && a.e.data.date) || 0));
const thoughts = pick('thought').sort((a, b) => +(b.e.data as any).date - +(a.e.data as any).date);
const stars = (n = 0) => '★'.repeat(Math.floor(n)) + (n % 1 ? '☆' : '');
---
<Base title="ARCHIVE · 아카이브" description="주제별로 오래 보관하고 싶은 기록">
  <PageHead en="ARCHIVE" ko="아카이브" desc="주제별로 오래 보관하고 싶은 기록을 모으는 공간."
    tabs={[{ label: 'READING · 독서', href: '#reading' }, { label: 'PLACES · 장소', href: '#places' }, { label: 'NOTES · 문장·메모', href: '#notes' }]} />

  <Box title="READING" sub="독서" id="reading">
    <h3 class="sub">요즘 읽는 책</h3>
    <div class="books">{reading.map(({ e, Content }) => e.data.kind === 'book' && (
      <div class="book now"><div class="spine">{e.data.title}</div><div><b>{e.data.title}</b><small>{e.data.author}{e.data.started && ` · ${isoDate(e.data.started)}~`}</small><div class="note"><Content /></div></div></div>
    ))}</div>
    <h3 class="sub">다 읽은 책</h3>
    <ul class="list">{done.map(({ e }) => e.data.kind === 'book' && (
      <li><span>{e.data.title} <small class="muted">{e.data.author}</small></span><span class="meta">{stars(e.data.rating)} {e.data.finished && isoDate(e.data.finished)}</span></li>
    ))}</ul>
    <h3 class="sub">읽고 싶은 책</h3>
    <ul class="list">{want.map(({ e }) => e.data.kind === 'book' && <li><span>☐ {e.data.title} <small class="muted">{e.data.author}</small></span></li>)}</ul>
  </Box>

  <Box title="PLACES" sub="다시 가고 싶은 곳" id="places">
    <div class="places">{places.map(({ e, Content }) => e.data.kind === 'place' && (
      <div class="place"><b>📍 {e.data.title}</b><small>{e.data.location}{e.data.visited && ` · ${isoDate(e.data.visited)}`}{e.data.revisit && ' · ♥ 다시 가고 싶어'}</small><div class="note"><Content /></div></div>
    ))}</div>
  </Box>

  <Box title="NOTES" sub="문장·메모" id="notes">
    <h3 class="sub">마음에 남은 문장 <small class="muted">★ 표시한 문장은 COLLECTION에도 모여요</small></h3>
    <div class="quotes">{quotes.map(({ e, Content }) => e.data.kind === 'quote' && (
      <blockquote class:list={{ star: e.data.starred }}><Content />{e.data.source && <cite>— {e.data.source}</cite>}{e.data.starred && <i>★</i>}</blockquote>
    ))}</div>
    <h3 class="sub">틈틈이 적어둔 생각</h3>
    <ul class="list thoughts">{thoughts.map(({ e, Content }) => e.data.kind === 'thought' && <li><span><Content /></span><time>{isoDate(e.data.date)}</time></li>)}</ul>
  </Box>
</Base>
<style>
  .sub { font: 700 16px var(--hand); margin: 14px 0 6px; }
  .sub small { font: 11px var(--font); }
  .books { display: flex; flex-direction: column; gap: 8px; }
  .book { display: flex; gap: 12px; align-items: stretch; border: 1.5px solid var(--line); border-radius: 8px; padding: 8px; background: #fff; }
  .spine { writing-mode: vertical-rl; background: repeating-linear-gradient(0deg, var(--pink) 0 4px, var(--pink-deep) 4px 5px); color: #fff; font: 11px var(--pixel); padding: 8px 4px; border-radius: 3px; max-height: 110px; overflow: hidden; }
  .book small, .place small { display: block; color: var(--mute); font: 11px var(--pixel); }
  .note { font-size: 12.5px; color: #777; }
  .note :global(p) { margin: 4px 0 0; }
  .places { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 8px; }
  .place { border: 1.5px dashed var(--pink); border-radius: 8px; padding: 8px 10px; background: var(--pink-soft); }
  .quotes { display: grid; gap: 8px; }
  blockquote { position: relative; margin: 0; padding: 10px 14px; border-left: 3px solid var(--line); background: #fafafa; border-radius: 0 8px 8px 0; font-size: 13.5px; }
  blockquote.star { border-left-color: var(--pink); background: var(--pink-soft); }
  blockquote :global(p) { margin: 0; }
  cite { display: block; font: normal 11px var(--pixel); color: var(--mute); margin-top: 4px; }
  blockquote i { position: absolute; top: 6px; right: 10px; color: var(--pink-deep); font-style: normal; }
  .thoughts :global(p) { margin: 0; }
</style>
