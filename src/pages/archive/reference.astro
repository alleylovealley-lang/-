  :global(.refp .rimg) { display: block; width: 100%; margin: 0 0 10px; padding: 0; border: 1.5px solid var(--line); border-radius: 8px; background: #fff; overflow: hidden; cursor: zoom-in; break-inside: avoid; position: relative; text-align: left; }
