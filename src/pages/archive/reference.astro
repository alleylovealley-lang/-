---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import { url, getReferences } from '../../lib/utils';
const refs = await getReferences();
const albums = [...Map.groupBy(refs, (r) => r.data.album)];
---
<Base title="REFERENCE · 레퍼런스" description="종류별 레퍼런스 앨범">
  <PageHead en="REFERENCE" ko="레퍼런스" desc="종류별로 모아둔 레퍼런스 앨범." />
  <div class="filter" role="group" aria-label="앨범">
    <button type="button" data-a="all" aria-pressed="true">ALL ({refs.length})</button>
    {albums.map(([a, xs]) => <button type="button" data-a={a} aria-pressed="false">{a} ({xs.length})</button>)}
  </div>
  {albums.map(([a, xs]) => (
    <section class="album" data-a={a}>
      <h2>📁 {a}</h2>
      <div class="grid">{xs.map((r) => (
        <a href={r.data.source || url(r.data.image)} target="_blank" rel="noopener" class="cell" title={r.data.title}>
          <img src={url(r.data.image)} alt={r.data.title ?? ''} loading="lazy" />
          {r.data.title && <span>{r.data.title}</span>}
        </a>
      ))}</div>
    </section>
  ))}
</Base>
<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('.filter button');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.album').forEach((s) => (s.hidden = b.dataset.a !== 'all' && s.dataset.a !== b.dataset.a));
  }));
</script>
<style>
  .album { margin-top: 14px; }
  h2 { font: 400 13px var(--pixel); color: var(--pink-deep); margin: 0 0 6px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; }
  .cell { text-decoration: none; font-size: 11.5px; color: var(--mute); }
  .cell img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; border: 1.5px solid var(--line); display: block; }
  .cell:hover img { border-color: var(--pink); }
</style>
