  :global(.refp .album:hover) { transform: translate(-1px, -1px); border-color: var(--pink-deep); box-shadow: 4px 4px 0 var(--pink); }
  :global(.refp .album.pending) { border-style: dashed; }
  :global(.refp .album .cover) { aspect-ratio: 4 / 3; border-radius: 6px; overflow: hidden; background: repeating-linear-gradient(45deg, #f4f4f4 0 8px, #fafafa 8px 16px); display: grid; place-items: center; border: 1px solid var(--line); }
  :global(.refp .album .cover img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  :global(.refp .album .cover i) { font: normal 11px var(--pixel); color: var(--mute); text-align: center; line-height: 1.8; }
  :global(.refp .album .meta) { display: flex; justify-content: space-between; align-items: baseline; gap: 6px; padding: 2px 2px 0; }
  :global(.refp .album .meta b) { font: 400 13px var(--pixel); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  :global(.refp .album .meta small) { font: 10.5px var(--pixel); color: var(--mute); flex-shrink: 0; }
