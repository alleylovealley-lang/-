  /* 앨범 안 */
  .ahead { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; align-items: center; margin-bottom: 12px; }
  .back { grid-column: 1 / -1; font: 11px var(--pixel); color: var(--mute); text-decoration: none; }
  .back:hover { color: var(--pink-deep); }
  .atitle { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; min-width: 0; }
  .atitle h2 { margin: 0; font: 400 18px var(--pixel); }
  .cnt { font: 11px var(--pixel); color: var(--mute); }
