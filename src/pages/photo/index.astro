---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Box from '../../components/Box.astro';
import { url, getPhotos, isoDate, md } from '../../lib/utils';
const photos = await getPhotos();
const byMonth = Map.groupBy(photos, (p) => isoDate(p.data.date).slice(0, 7));
const albums = [...Map.groupBy(photos, (p) => p.data.album)];
---
<Base title="PHOTO · 사진" description="사진과 일상의 순간을 보관하는 공간">
  {photos.length === 0 && <><PageHead en="PHOTO" ko="사진" desc="앨범별로 사진을 보관하는 공간." /><p class="empty">아직 사진이 없어요</p></>}
  {photos.length > 0 && <><PageHead en="PHOTO" ko="사진" desc="앨범별로 사진을 보관하는 공간."
    tabs={[{ label: '최근 사진', href: '#moments' }, { label: '앨범', href: '#albums' }, { label: '날짜별', href: '#by-date' }]} />

  <Box title="RECENT" sub="최근 사진" id="moments">
    <div class="strip">{photos.slice(0, 4).map((p, i) => (
      <a class="pol" href={url(p.data.image)} style={`--r:${[-3, 2, -1, 3][i % 4]}deg`}><img src={url(p.data.image)} alt={p.data.caption ?? ''} loading="lazy" /><span>{p.data.caption}</span></a>
    ))}</div>
  </Box>

  <Box title="ALBUMS" sub="앨범" id="albums">
    <div class="albums">{albums.map(([a, xs]) => (
      <a class="alb" href={`#album-${a}`}><span class="stack">{xs.slice(0, 3).map((p) => <img src={url(p.data.image)} alt="" loading="lazy" />)}</span><b>{a}</b><small>{xs.length}장</small></a>
    ))}</div>
    {albums.map(([a, xs]) => (
      <div class="month" id={`album-${a}`}><h3>📁 {a}</h3><div class="grid">{xs.map((p) => (
        <a href={url(p.data.image)} class="cell"><img src={url(p.data.image)} alt={p.data.caption ?? ''} loading="lazy" /><span>{md(p.data.date)} {p.data.caption}</span></a>
      ))}</div></div>
    ))}
  </Box>

  <Box title="날짜별 사진" sub="BY DATE" id="by-date">
    {[...byMonth].map(([month, items]) => (
      <div class="month">
        <h3>{month.replace('-', '. ')}</h3>
        <div class="grid">{items.map((p) => (
          <a href={url(p.data.image)} class="cell"><img src={url(p.data.image)} alt={p.data.caption ?? ''} loading="lazy" /><span>{md(p.data.date)} {p.data.caption}</span></a>
        ))}</div>
      </div>
    ))}
  </Box>

</>}
</Base>
<style>
  .strip { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; padding: 6px 0 10px; }
  .pol { width: 140px; background: #fff; padding: 8px 8px 26px; box-shadow: 0 3px 8px rgba(0,0,0,.12); transform: rotate(var(--r)); text-decoration: none; text-align: center; font: 400 15px var(--hand); position: relative; }
  .pol img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; margin-bottom: 4px; }
  .pol:hover { transform: rotate(0) scale(1.04); }
  .month h3 { font: 400 12px var(--pixel); color: var(--mute); margin: 10px 0 6px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 8px; }
  .cell { position: relative; text-decoration: none; font-size: 11.5px; color: var(--mute); }
  .cell img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; border: 1.5px solid var(--line); display: block; }
  .cell:hover img { border-color: var(--pink); }
  .cell i { position: absolute; top: 6px; right: 8px; color: var(--pink-deep); font-style: normal; text-shadow: 0 0 3px #fff; }
  .albums { display: flex; flex-wrap: wrap; gap: 14px; margin-bottom: 8px; }
  .alb { display: flex; flex-direction: column; align-items: center; text-decoration: none; font-size: 12.5px; }
  .stack { position: relative; width: 110px; height: 90px; }
  .stack img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 4px solid #fff; box-shadow: 0 2px 5px rgba(0,0,0,.15); border-radius: 4px; }
  .stack img:nth-child(1) { transform: rotate(-6deg); } .stack img:nth-child(2) { transform: rotate(4deg); }
  .alb small { font: 10px var(--pixel); color: var(--mute); }
  .month { scroll-margin-top: 20px; }
</style>
