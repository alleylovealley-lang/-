---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Box from '../../components/Box.astro';
import { render } from 'astro:content';
import { url, getReviews, isoDate, stars, REVIEW_KINDS } from '../../lib/utils';

export function getStaticPaths() {
  return [
    { params: { kind: 'book' }, props: { en: 'BOOK', ko: '도서', kinds: ['book'], desc: '읽은 책, 읽는 중인 책, 읽고 싶은 책.', st: { doing: '읽는 중', done: '다 읽음', want: '읽고 싶음' } } },
    { params: { kind: 'anime' }, props: { en: 'ANIME', ko: '애니메이션', kinds: ['anime'], desc: '애니메이션 감상 기록.', st: { doing: '보는 중', done: '다 봄', want: '보고 싶음' } } },
    { params: { kind: 'movie' }, props: { en: 'MOVIE & DRAMA', ko: '영화·드라마', kinds: ['movie', 'drama'], desc: '영화와 드라마 감상 기록.', st: { doing: '보는 중', done: '다 봄', want: '보고 싶음' } } },
  ];
}
const { en, ko, kinds, desc, st } = Astro.props;
const all = await Promise.all((await getReviews()).filter((r) => kinds.includes(r.data.kind)).map(async (e) => ({ e, Content: (await render(e)).Content })));
const sec = (s: string) => all.filter(({ e }) => e.data.status === s).sort((a, b) => +(b.e.data.date ?? 0) - +(a.e.data.date ?? 0));
const rated = all.filter(({ e }) => e.data.rating != null);
const avg = rated.length ? rated.reduce((s, { e }) => s + (e.data.rating ?? 0), 0) / rated.length : 0;
---
<Base title={`${en} · ${ko}`} description={desc}>
  <PageHead en={en} ko={ko} desc={desc} />
  <div class="sumbar">
    <div class="hl"><small>{st.done}</small><b>{sec('done').length}</b></div>
    <div><small>{st.doing}</small><b>{sec('doing').length}</b></div>
    <div><small>평균 별점</small><b>{avg ? avg.toFixed(1) : '-'}</b></div>
  </div>
  {(['doing', 'done', 'want'] as const).map((s) => (
    <Box title={st[s]} sub={s.toUpperCase()}>
      {sec(s).length ? (
        <div class="cards">{sec(s).map(({ e, Content }) => (
          <article class="rv">
            {e.data.cover ? <img src={url(e.data.cover)} alt="" loading="lazy" /> : <div class="cv" aria-hidden="true"><span>{e.data.title}</span></div>}
            <div class="info">
              <span class="kind">{REVIEW_KINDS[e.data.kind]}</span>
              <b>{e.data.title}</b>
              {e.data.creator && <small>{e.data.creator}</small>}
              {e.data.rating != null && <span class="star" title={`${e.data.rating}점`}>{stars(e.data.rating)}</span>}
              {e.data.date && <small>{isoDate(e.data.date)}</small>}
              <div class="tx"><Content /></div>
            </div>
          </article>
        ))}</div>
      ) : <p class="empty">아직 없어요</p>}
    </Box>
  ))}
</Base>
<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
  .rv { display: flex; gap: 10px; border: 1.5px solid var(--line); border-radius: 8px; padding: 8px; background: #fff; }
  .rv img, .cv { width: 70px; height: 96px; flex-shrink: 0; border-radius: 4px; object-fit: cover; }
  .cv { display: flex; align-items: flex-end; padding: 6px; background: repeating-linear-gradient(0deg, var(--pink) 0 6px, var(--pink-deep) 6px 7px); color: #fff; font: 10px/1.3 var(--pixel); overflow: hidden; }
  .info { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
  .kind { font: 9px var(--pixel); color: var(--mute); }
  .info b { font-size: 14px; }
  .info small { color: var(--mute); font: 11px var(--pixel); }
  .star { color: var(--pink-deep); font-size: 13px; letter-spacing: 1px; }
  .tx { font-size: 12.5px; color: #666; }
  .tx :global(p) { margin: 4px 0 0; }
</style>
