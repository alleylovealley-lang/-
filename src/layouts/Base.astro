---
import '@fontsource/gowun-dodum';
import '../styles/global.css';
import Deco from '../components/Deco.astro';
import Calendar from '../components/Calendar.astro';
import TodayWidget from '../components/TodayWidget.astro';
import QuestBar from '../components/QuestBar.astro';
import { SITE } from '../site.config';
import { url, getBooks } from '../lib/utils';
import { currentPath, findNav, groupHref } from '../lib/nav';

interface Props { title?: string; description?: string; type?: 'website' | 'article'; bare?: boolean; }
const { title, description = SITE.description, type = 'website', bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const I = SITE.images;

const path = currentPath(Astro.url.pathname);
const activeGroup = findNav(path).group?.key;
const reading = (await getBooks()).filter((b) => b.data.status === 'reading').slice(0, 2);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="theme-color" content="#2f2f2f" />
    <slot name="head" />
  </head>
  <body>
    <div class="outer">
      <div class="inner">
        <header class="hd">
          <a href={url('/')} class="hd-icon" aria-label="홈으로"><Deco item={I.icon} label="📷 아이콘" hint="150×150" /></a>
          <div class="banner">
            <Deco item={I.banner} label="🖼 헤더 배너" hint="860×150" class="banner-img" />
            {SITE.headerTitle && <a href={url('/')} class="banner-title">{SITE.headerTitle}</a>}
          </div>
        </header>

        <nav class="mnav" aria-label="메뉴">
          <a href={url('/')} aria-current={path === '/' ? 'page' : undefined}>🏠</a>
          {SITE.nav.map((g) => <a href={url(groupHref(g))} aria-current={activeGroup === g.key ? 'page' : undefined}>{g.label}</a>)}
        </nav>

        <aside class="side left">
          <div class="p">
            <Deco item={I.mascot} label="캐릭터" hint="(gif 가능)" class="mascot" />
            <div class="me"><b>{SITE.name}</b></div>
          </div>
          <div class="p">
            <div class="cap">mood</div>
            <div class="center">{SITE.mood}</div>
          </div>
          {reading.length > 0 && (
            <div class="p">
              <div class="cap">reading</div>
              {reading.map((b) => <a class="reading" href={url('/review/reading')}><span class="spine" aria-hidden="true"></span><span><b>{b.data.title}</b>{b.data.author && <small>{b.data.author}</small>}</span></a>)}
            </div>
          )}
          {(I.sideBanner.src || SITE.showPlaceholders) && (
            <div class="p tight"><Deco item={I.sideBanner} label="세로 배너" hint="사진·스티커" class="sidebanner" /></div>
          )}
          {I.friends.some((f) => f.src || SITE.showPlaceholders) && (
            <div class="p">
              <div class="cap">friends</div>
              <div class="stack">{I.friends.map((f) => <Deco item={f} label="친구 버튼" hint="88×31" class="b88" />)}</div>
            </div>
          )}
        </aside>

        <main class:list={['main', { panel: !bare }]}>
          <slot />
        </main>

        <aside class="side right">
          <nav class="p nav" aria-label="메뉴">
            <Deco item={I.navTitle} label="NAVIGATION" class="navtitle" />
            <a class="home" href={url('/')} aria-current={path === '/' ? 'page' : undefined}><span aria-hidden="true">🏠</span> HOME · 홈</a>
            <hr class="home-sep" />
            {SITE.nav.map((g) => (
              <a href={url(groupHref(g))} aria-current={activeGroup === g.key ? 'page' : undefined}><span>{g.label}<small>{g.ko}</small></span><span aria-hidden="true">🎀</span></a>
            ))}
          </nav>
          <div class="p">
            <div class="cap">calendar</div>
            <Calendar />
          </div>
          <div class="p">
            <div class="cap">today</div>
            <TodayWidget />
          </div>
          <a class="p questlink" href={url('/schedule/quest')}>
            <div class="cap">quest</div>
            <QuestBar />
          </a>
          {(I.myButton.src || SITE.showPlaceholders) && (
            <div class="p">
              <div class="cap">link me!</div>
              <Deco item={I.myButton} label="내 버튼" hint="88×31" class="b88 centered" />
              {I.myButton.src && (
                <textarea class="code" readonly aria-label="내 버튼 퍼가기 코드">{`<a href="${new URL(import.meta.env.BASE_URL, Astro.site)}"><img src="${new URL(url(I.myButton.src), Astro.site)}" alt="${SITE.title}"></a>`}</textarea>
              )}
            </div>
          )}
        </aside>

        <footer class="p foot">
          <a href={url('/')}>home</a> | <a href={url('/about')}>about</a> | <a href={url('/tags')}>tags</a> | <a href={url('/backup')}>backup</a> | <a href={url('/rss.xml')}>rss</a>
          <div>{SITE.name} © {SITE.startYear < year ? `${SITE.startYear}–${year}` : year} – ∞</div>
        </footer>
      </div>
    </div>
  </body>
</html>
