---
import '@fontsource/gowun-dodum';
import '../styles/global.css';
import Deco from '../components/Deco.astro';
import Calendar from '../components/Calendar.astro';
import NavTree from '../components/NavTree.astro';
import { SITE } from '../site.config';
import my from '../data/site.json';
import { url } from '../lib/utils';
import { currentPath, findNav } from '../lib/nav';

interface Props { title?: string; description?: string; type?: 'website' | 'article'; bare?: boolean; }
const { title, description = SITE.description, type = 'website', bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const I = SITE.images;
const P = SITE.profile;

const path = currentPath(Astro.url.pathname);
const { group: curGroup, item: curItem } = findNav(path);
const activeGroup = curGroup?.key;
const activeItem = curItem?.href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="theme-color" content="#2f2f2f" />
    <script is:inline>
      try {
        var z = JSON.parse(localStorage.getItem('hong.zoom') || '"1"'); if (z !== '1') document.documentElement.style.setProperty('zoom', z);
        if (JSON.parse(localStorage.getItem('hong.marquee') || '"on"') === 'off') document.documentElement.classList.add('no-marquee');
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body data-mybuilt={JSON.stringify(my)} data-base={url('/')} data-raw={`https://raw.githubusercontent.com/${SITE.repo.owner}/${SITE.repo.name}/${SITE.repo.branch}/public/`}>
    <div class="topbar" role="presentation">
      <span class="tb-clock" aria-label="현재 시각">♡ <time data-clock>----.--.-- --:--:--</time></span>
      <span class="tb-marquee" aria-hidden="true"><span class="tb-track">{[...SITE.topbar, ...SITE.topbar].map((m) => <span>{m}</span>)}</span></span>
      <a class="tb-coin" href={url('/game/pet')} title="미니게임 코인">🪙 <b data-coins>100</b></a>
    </div>
    <div class="outer">
      <div class="inner">
        <header class="hd">
          <div class="banner">
            <Deco item={I.banner} label="🖼 헤더 배너" hint="가로로 긴 이미지 · 1400×160" class="banner-img" my="banner" />
            {SITE.headerTitle && <a href={url('/')} class="banner-title">{SITE.headerTitle}</a>}
          </div>
        </header>

        <nav class="mnav" aria-label="메뉴">
          <a class="mhome" href={url('/')} aria-current={path === '/' ? 'page' : undefined}>🏠 HOME</a>
          <details>
            <summary>☰ MENU{curItem && <small> · {curItem.ko}</small>}</summary>
            <div class="mtree"><NavTree prefix="m" activeGroup={activeGroup} activeItem={activeItem} /></div>
          </details>
        </nav>

        <aside class="side left">
          <section class="p profile" aria-label="프로필">
            <div class="pf-row">
              <Deco item={P.photo} label="📷" class="pf-photo" my="photo" />
              <div class="pf-text">
                <div class="pf-name" data-my="name">{SITE.name}</div>
                <div class="pf-status" data-my="status" hidden={!P.status}>{P.status}</div>
              </div>
            </div>
            <details class="pf-more" data-my-items-wrap hidden={P.items.length === 0}>
              <summary>내 정보</summary>
              <dl class="pf-info" data-my-items>{P.items.map((it) => <><dt>{it.label}</dt><dd>{it.value}</dd></>)}</dl>
            </details>
          </section>
          <nav class="p nav" aria-label="메뉴">
            <Deco item={I.navTitle} label="NAVIGATION" class="navtitle" my="navTitle" />
            <a class="home" href={url('/')} aria-current={path === '/' ? 'page' : undefined}><span aria-hidden="true">🏠</span> HOME · 홈</a>
            <hr class="home-sep" />
            <NavTree prefix="d" activeGroup={activeGroup} activeItem={activeItem} />
          </nav>
        </aside>

        <main class:list={['main', { panel: !bare }]}>
          <slot />
        </main>

        <aside class="side right">
          <div class="p">
            <div class="cap">calendar</div>
            <Calendar />
          </div>
          {(I.sideBanner.src || SITE.showPlaceholders) && (
            <div class="p tight"><Deco item={I.sideBanner} label="세로 배너" hint="컨셉 이미지 · 210×560" class="sidebanner" my="sideBanner" /></div>
          )}
        </aside>

        <footer class="p foot">
          <a href={url('/')}>home</a> | <a href={url('/about')}>about</a> | <a href={url('/tags')}>tags</a> | <a href={url('/archive/backup')}>backup</a> | <a href={url('/rss.xml')}>rss</a>
          <div><span data-my="name">{SITE.name}</span> © {SITE.startYear < year ? `${SITE.startYear}–${year}` : year} – ∞</div>
        </footer>
      </div>
    </div>
    <script is:inline>
      // 설정 › 프로필·꾸미기에서 저장한 내용 — 사이트에 반영되기 전(1~2분)에도 바로 보여 주기
      (function () {
        var K = ['name', 'title', 'status', 'items', 'photo', 'banner', 'sideBanner', 'navTitle'];
        window.__applyMy = function (local) {
          try {
            var p = JSON.parse(localStorage.getItem('hong.pending.site') || 'null'), b = document.body.dataset;
            var built = JSON.parse(b.mybuilt || '{}');
            if (p && (Date.now() - p.ts > 30 * 60000 || K.every(function (k) { return JSON.stringify(p.data[k]) === JSON.stringify(built[k]); }))) { localStorage.removeItem('hong.pending.site'); p = null; }
            if (!p && !local) return;
            var d = p ? p.data : built, at = function (v, k) {
              if (local && local[k]) return local[k];
              if (/^https?:/.test(v)) return v;
              return (v === built[k] ? b.base : b.raw) + v.replace(/^\//, '');
            };
            document.querySelectorAll('[data-my]').forEach(function (el) {
              var k = el.getAttribute('data-my'); el.textContent = d[k] || ''; if (k === 'status') el.hidden = !d.status;
            });
            var wrap = document.querySelector('[data-my-items-wrap]'), dl = document.querySelector('[data-my-items]');
            if (wrap && dl) {
              wrap.hidden = !(d.items || []).length; dl.textContent = '';
              (d.items || []).forEach(function (it) { var t = document.createElement('dt'), v = document.createElement('dd'); t.textContent = it.label; v.textContent = it.value; dl.append(t, v); });
            }
            document.querySelectorAll('[data-my-img]').forEach(function (el) {
              var k = el.getAttribute('data-my-img'), v = d[k];
              if (!el.__orig) el.__orig = { html: el.innerHTML, ph: el.classList.contains('ph') };
              if (v === built[k] && !(local && local[k] && v)) { el.innerHTML = el.__orig.html; el.classList.toggle('ph', el.__orig.ph); return; }
              el.textContent = '';
              if (v) { el.classList.remove('ph'); var im = document.createElement('img'); im.src = at(v, k); im.alt = ''; el.append(im); }
              else { el.classList.add('ph'); var s = document.createElement('span'), t = document.createElement('b'); t.textContent = el.getAttribute('data-my-label') || ''; s.append(t); el.append(s); }
            });
          } catch (e) {}
        };
        window.__applyMy();
      })();
    </script>
    <script is:inline>
      (function () {
        var el = document.querySelector('[data-clock]'), D = '일월화수목금토';
        var p = function (n) { return String(n).padStart(2, '0'); };
        var tick = function () { var d = new Date(); el.textContent = d.getFullYear() + '.' + p(d.getMonth() + 1) + '.' + p(d.getDate()) + ' (' + D[d.getDay()] + ') ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds()); };
        tick(); setInterval(tick, 1000);
        var c = document.querySelector('[data-coins]');
        var show = function () { try { var v = localStorage.getItem('hong.coins'); c.textContent = v == null ? '100' : JSON.parse(v); } catch (e) {} };
        show(); window.addEventListener('coins', show); window.addEventListener('storage', show);
      })();
    </script>
    <script is:inline>
      (function () {
        var KEY = 'hong.nav-folded', folded = [];
        try { folded = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
        var groups = document.querySelectorAll('.grp');
        var apply = function () {
          groups.forEach(function (g) {
            var f = folded.indexOf(g.dataset.key) > -1 && !g.classList.contains('on');
            g.classList.toggle('folded', f); g.querySelector('.gh').setAttribute('aria-expanded', String(!f));
          });
        };
        groups.forEach(function (g) {
          g.querySelector('.gh').addEventListener('click', function () {
            var k = g.dataset.key, willFold = !g.classList.contains('folded');
            folded = folded.filter(function (x) { return x !== k; }); if (willFold) folded.push(k);
            try { localStorage.setItem(KEY, JSON.stringify(folded)); } catch (e) {}
            g.classList.toggle('folded', willFold); g.querySelector('.gh').setAttribute('aria-expanded', String(!willFold));
          });
        });
        apply();
      })();
    </script>
  </body>
</html>
