---
import '@fontsource/gowun-dodum';
import '../styles/global.css';
import Deco from '../components/Deco.astro';
import Calendar from '../components/Calendar.astro';
import TodayWidget from '../components/TodayWidget.astro';
import QuestBar from '../components/QuestBar.astro';
import NavTree from '../components/NavTree.astro';
import { SITE } from '../site.config';
import { url, getReviews } from '../lib/utils';
import { currentPath, findNav } from '../lib/nav';

interface Props { title?: string; description?: string; type?: 'website' | 'article'; bare?: boolean; }
const { title, description = SITE.description, type = 'website', bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const I = SITE.images;

const path = currentPath(Astro.url.pathname);
const { group: curGroup, item: curItem } = findNav(path);
const activeGroup = curGroup?.key;
const activeItem = curItem?.href;
const reading = (await getReviews()).filter((b) => b.data.kind === 'book' && b.data.status === 'doing').slice(0, 2);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta name="theme-color" content="#2f2f2f" />
    <script is:inline>
      try {
        var z = JSON.parse(localStorage.getItem('hong.zoom') || '"1"'); if (z !== '1') document.documentElement.style.setProperty('zoom', z);
        if (JSON.parse(localStorage.getItem('hong.marquee') || '"on"') === 'off') document.documentElement.classList.add('no-marquee');
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <div class="topbar" role="presentation">
      <span class="tb-clock" aria-label="현재 시각">♡ <time data-clock>----.--.-- --:--:--</time></span>
      <span class="tb-marquee" aria-hidden="true"><span class="tb-track">{[...SITE.topbar, ...SITE.topbar].map((m) => <span>{m}</span>)}</span></span>
      <a class="tb-coin" href={url('/game/pet')} title="미니게임 코인">🪙 <b data-coins>100</b></a>
    </div>
    <div class="outer">
      <div class="inner">
        <header class="hd">
          <a href={url('/')} class="hd-icon" aria-label="홈으로"><Deco item={I.icon} label="📷 아이콘" hint="150×150" /></a>
          <div class="banner">
            <Deco item={I.banner} label="🖼 헤더 배너" hint="860×150" class="banner-img" />
            {SITE.headerTitle && <a href={url('/')} class="banner-title">{SITE.headerTitle}</a>}
          </div>
        </header>

        <nav class="mnav" aria-label="메뉴">
          <a class="mhome" href={url('/')} aria-current={path === '/' ? 'page' : undefined}>🏠 HOME</a>
          <details>
            <summary>☰ MENU{curItem && <small> · {curItem.ko}</small>}</summary>
            <div class="mtree"><NavTree prefix="m" activeGroup={activeGroup} activeItem={activeItem} /></div>
          </details>
        </nav>

        <aside class="side left">
          <div class="p">
            <Deco item={I.mascot} label="캐릭터" hint="(gif 가능)" class="mascot" />
            <div class="me"><b>{SITE.name}</b></div>
          </div>
          <div class="p">
            <div class="cap">mood</div>
            <div class="center">{SITE.mood}</div>
          </div>
          {reading.length > 0 && (
            <div class="p">
              <div class="cap">reading</div>
              {reading.map((b) => <a class="reading" href={url('/review/book')}><span class="spine" aria-hidden="true"></span><span><b>{b.data.title}</b>{b.data.creator && <small>{b.data.creator}</small>}</span></a>)}
            </div>
          )}
          {(I.sideBanner.src || SITE.showPlaceholders) && (
            <div class="p tight"><Deco item={I.sideBanner} label="세로 배너" hint="사진·스티커" class="sidebanner" /></div>
          )}
          {I.friends.some((f) => f.src || SITE.showPlaceholders) && (
            <div class="p">
              <div class="cap">friends</div>
              <div class="stack">{I.friends.map((f) => <Deco item={f} label="친구 버튼" hint="88×31" class="b88" />)}</div>
            </div>
          )}
        </aside>

        <main class:list={['main', { panel: !bare }]}>
          <slot />
        </main>

        <aside class="side right">
          <nav class="p nav" aria-label="메뉴">
            <Deco item={I.navTitle} label="NAVIGATION" class="navtitle" />
            <a class="home" href={url('/')} aria-current={path === '/' ? 'page' : undefined}><span aria-hidden="true">🏠</span> HOME · 홈</a>
            <hr class="home-sep" />
            <NavTree prefix="d" activeGroup={activeGroup} activeItem={activeItem} />
          </nav>
          <div class="p">
            <div class="cap">calendar</div>
            <Calendar />
          </div>
          <div class="p">
            <div class="cap">today</div>
            <TodayWidget />
          </div>
          <a class="p questlink" href={url('/etc/quest')}>
            <div class="cap">quest</div>
            <QuestBar />
          </a>
          {(I.myButton.src || SITE.showPlaceholders) && (
            <div class="p">
              <div class="cap">link me!</div>
              <Deco item={I.myButton} label="내 버튼" hint="88×31" class="b88 centered" />
              {I.myButton.src && (
                <textarea class="code" readonly aria-label="내 버튼 퍼가기 코드">{`<a href="${new URL(import.meta.env.BASE_URL, Astro.site)}"><img src="${new URL(url(I.myButton.src), Astro.site)}" alt="${SITE.title}"></a>`}</textarea>
              )}
            </div>
          )}
        </aside>

        <footer class="p foot">
          <a href={url('/')}>home</a> | <a href={url('/about')}>about</a> | <a href={url('/tags')}>tags</a> | <a href={url('/archive/backup')}>backup</a> | <a href={url('/rss.xml')}>rss</a>
          <div>{SITE.name} © {SITE.startYear < year ? `${SITE.startYear}–${year}` : year} – ∞</div>
        </footer>
      </div>
    </div>
    <script is:inline>
      (function () {
        var el = document.querySelector('[data-clock]'), D = '일월화수목금토';
        var p = function (n) { return String(n).padStart(2, '0'); };
        var tick = function () { var d = new Date(); el.textContent = d.getFullYear() + '.' + p(d.getMonth() + 1) + '.' + p(d.getDate()) + ' (' + D[d.getDay()] + ') ' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':' + p(d.getSeconds()); };
        tick(); setInterval(tick, 1000);
        var c = document.querySelector('[data-coins]');
        var show = function () { try { var v = localStorage.getItem('hong.coins'); c.textContent = v == null ? '100' : JSON.parse(v); } catch (e) {} };
        show(); window.addEventListener('coins', show); window.addEventListener('storage', show);
      })();
    </script>
    <script is:inline>
      (function () {
        var KEY = 'hong.nav-folded', folded = [];
        try { folded = JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) {}
        var groups = document.querySelectorAll('.grp');
        var apply = function () {
          groups.forEach(function (g) {
            var f = folded.indexOf(g.dataset.key) > -1 && !g.classList.contains('on');
            g.classList.toggle('folded', f); g.querySelector('.gh').setAttribute('aria-expanded', String(!f));
          });
        };
        groups.forEach(function (g) {
          g.querySelector('.gh').addEventListener('click', function () {
            var k = g.dataset.key, willFold = !g.classList.contains('folded');
            folded = folded.filter(function (x) { return x !== k; }); if (willFold) folded.push(k);
            try { localStorage.setItem(KEY, JSON.stringify(folded)); } catch (e) {}
            g.classList.toggle('folded', willFold); g.querySelector('.gh').setAttribute('aria-expanded', String(!willFold));
          });
        });
        apply();
      })();
    </script>
  </body>
</html>
